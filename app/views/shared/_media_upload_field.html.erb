<%# Shared Media Upload Component with Compression to KB, Live Preview & Cloudinary Upload %>
<div class="space-y-3" data-controller="media-uploader">
  <%= form.label field_name, label_text, class: "block text-xs font-bold text-slate-300" %>

  <!-- URL Input Field (populated automatically on upload or manual edit) -->
  <div class="relative flex items-center">
    <%= form.text_field field_name, 
        data: { media_uploader_target: "input", action: "change->media-uploader#checkInitialValue" }, 
        class: "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-plum-500 pr-24", 
        placeholder: placeholder_text || "https://res.cloudinary.com/... or choose file below" %>
  </div>

  <!-- File Upload Input (Image & Video) -->
  <div class="flex items-center gap-3">
    <label class="px-4 py-2.5 bg-plum-800/80 hover:bg-plum-700 text-plum-100 border border-plum-600/50 rounded-xl text-xs font-bold cursor-pointer transition-colors flex items-center gap-2 shadow-sm">
      <span>☁️ Upload Image/Video (Auto-Compress to KB)</span>
      <input type="file" 
             accept="image/*,video/*" 
             data-media-uploader-target="fileInput" 
             data-action="change->media-uploader#handleFileSelect" 
             class="hidden">
    </label>
    <span class="text-[11px] text-slate-400">Accepted: Images & Videos (compressed to KB automatically)</span>
  </div>

  <!-- Status & Size Badge -->
  <div class="flex items-center gap-3">
    <span data-media-uploader-target="status" class="text-xs font-medium text-slate-300"></span>
    <span data-media-uploader-target="badge" class="hidden"></span>
  </div>

  <!-- Upload Progress Bar -->
  <div class="w-full bg-slate-950 rounded-full h-1.5 overflow-hidden border border-slate-800 hidden" data-media-uploader-target="progressContainer">
    <div class="bg-gradient-to-r from-plum-600 to-emerald-500 h-1.5 transition-all duration-300 w-0 hidden" data-media-uploader-target="progress"></div>
  </div>

  <!-- Live Image / Video Preview Card -->
  <div class="hidden mt-3 p-4 bg-slate-950 border border-slate-800 rounded-2xl space-y-3" data-media-uploader-target="previewContainer">
    <div class="flex items-center justify-between text-xs font-bold text-slate-300 border-b border-slate-800 pb-2">
      <span>Media Preview</span>
      <button type="button" data-action="click->media-uploader#clearPreview" class="text-rose-400 hover:text-rose-300 text-xs font-semibold">✕ Remove</button>
    </div>

    <!-- Image Preview -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900 border border-slate-800 max-h-72 flex items-center justify-center">
      <img data-media-uploader-target="imagePreview" class="hidden max-h-72 w-auto object-contain rounded-xl shadow-lg" alt="Selected media preview" />
      <video data-media-uploader-target="videoPreview" controls class="hidden max-h-72 w-full rounded-xl shadow-lg"></video>
    </div>
  </div>
</div>
