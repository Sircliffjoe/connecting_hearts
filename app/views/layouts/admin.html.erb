<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
  <head>
    <title>Admin Dashboard | Connecting Hearts Foundation</title>
    <%= favicon_link_tag image_path("logo.png") %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0f172a">
    <link rel="manifest" href="/manifest.json">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-950 text-slate-100 font-sans antialiased" data-controller="admin-sidebar">
    <%= render "layouts/pwa_splash_screen" %>
    <% if logged_in? %>
      <!-- TOP HEADER BAR -->
      <header class="fixed top-0 left-0 right-0 h-16 bg-slate-900/95 backdrop-blur border-b border-slate-800 z-40 px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <!-- Mobile Sidebar Hamburger Toggle -->
          <button type="button" data-action="click->admin-sidebar#toggleMobile" class="lg:hidden p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none" aria-label="Toggle navigation menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>

          <!-- Top Header Brand Logo -->
          <%= link_to admin_dashboard_path, class: "flex items-center gap-2.5 group" do %>
            <%= image_tag "logo.png", alt: "Connecting Hearts Logo", class: "h-8 w-auto object-contain brightness-0 invert group-hover:scale-105 transition-transform" %>
            <div class="flex flex-col">
              <span class="font-serif font-bold text-base text-white leading-none">Connecting Hearts</span>
              <span class="text-[10px] text-plum-300 font-medium tracking-wide">Foundation Admin</span>
            </div>
          <% end %>
        </div>

        <!-- TOP RIGHT: USER PROFILE AVATAR DROPDOWN ONLY -->
        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle" class="flex items-center gap-3 p-1.5 rounded-full hover:bg-slate-800/80 transition-colors focus:outline-none group">
            <% if current_user.image_url.present? %>
              <%= image_tag current_user.image_url, alt: current_user.name, class: "w-9 h-9 rounded-full object-cover shadow-md border border-plum-500/40 group-hover:scale-105 transition-transform" %>
            <% else %>
              <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-plum-700 to-terracotta-500 text-white font-bold text-sm flex items-center justify-center shadow-md border border-plum-500/30 group-hover:scale-105 transition-transform">
                <%= current_user.name.first.upcase %>
              </div>
            <% end %>
            <div class="hidden sm:flex flex-col text-left pr-1">
              <span class="text-xs font-bold text-white leading-tight"><%= current_user.name %></span>
              <span class="text-[10px] text-slate-400 font-medium"><%= current_user.role.titleize %></span>
            </div>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <!-- AVATAR DROPDOWN MENU -->
          <div data-dropdown-target="menu" class="hidden absolute right-0 mt-3 w-60 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl py-2 z-50 animate-fade-in divide-y divide-slate-800">
            <div class="px-4 py-3">
              <p class="text-xs font-bold text-white"><%= current_user.name %></p>
              <p class="text-[11px] text-slate-400 truncate"><%= current_user.email %></p>
            </div>

            <div class="py-1">
              <%= link_to admin_profile_path, class: "flex items-center gap-3 px-4 py-2.5 text-xs font-medium text-slate-200 hover:bg-slate-800 hover:text-white transition-colors" do %>
                <span class="text-base">👤</span>
                <span>Profile</span>
              <% end %>

              <%= link_to admin_settings_path, class: "flex items-center gap-3 px-4 py-2.5 text-xs font-medium text-slate-200 hover:bg-slate-800 hover:text-white transition-colors" do %>
                <span class="text-base">⚙️</span>
                <span>Settings</span>
              <% end %>
            </div>

            <div class="py-1">
              <%= button_to admin_logout_path, method: :delete, class: "w-full flex items-center gap-3 px-4 py-2.5 text-xs font-medium text-rose-400 hover:bg-rose-950/40 hover:text-rose-300 transition-colors text-left" do %>
                <span class="text-base">🚪</span>
                <span>Logout</span>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <!-- DESKTOP FIXED SIDEBAR -->
      <aside class="hidden lg:flex flex-col w-64 fixed inset-y-0 left-0 bg-slate-900 border-r border-slate-800 pt-20 pb-6 z-30 overflow-y-auto">
        <div class="px-4 mb-4">
          <div class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-3">
            <%= image_tag "logo.png", alt: "Logo", class: "h-7 w-auto object-contain brightness-0 invert" %>
            <div class="text-[11px]">
              <span class="font-bold text-white block">Main Navigation</span>
              <span class="text-slate-400 text-[10px]">Managing Foundation</span>
            </div>
          </div>
        </div>

        <nav class="flex-1 px-3 space-y-1.5">
          <!-- 1. DASHBOARD -->
          <%= link_to admin_dashboard_path, class: "flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition-colors #{current_page?(admin_dashboard_path) ? 'bg-plum-800/80 text-white border border-plum-700/60 shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
            <span class="text-base">📊</span>
            <span>Dashboard</span>
          <% end %>

          <!-- 2. EVENTS (COLLAPSIBLE) -->
          <div class="space-y-1">
            <button type="button" data-action="click->admin-sidebar#toggleSection" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-colors text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none">
              <div class="flex items-center gap-3">
                <span class="text-base">📅</span>
                <span>Events</span>
              </div>
              <svg class="chevron-icon w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="pl-9 pr-2 space-y-1">
              <%= link_to "All Events", admin_events_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_events_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
              <%= link_to "+ Add New Event", new_admin_event_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white" %>
            </div>
          </div>

          <!-- 3. STORIES (COLLAPSIBLE) -->
          <div class="space-y-1">
            <button type="button" data-action="click->admin-sidebar#toggleSection" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-colors text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none">
              <div class="flex items-center gap-3">
                <span class="text-base">📖</span>
                <span>Stories</span>
              </div>
              <svg class="chevron-icon w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="pl-9 pr-2 space-y-1">
              <%= link_to "All Stories", admin_stories_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_stories_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
              <%= link_to "+ Create Story", new_admin_story_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white" %>
            </div>
          </div>

          <!-- 4. RESOURCES (COLLAPSIBLE) -->
          <div class="space-y-1">
            <button type="button" data-action="click->admin-sidebar#toggleSection" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-colors text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none">
              <div class="flex items-center gap-3">
                <span class="text-base">📚</span>
                <span>Resources</span>
              </div>
              <svg class="chevron-icon w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="pl-9 pr-2 space-y-1">
              <%= link_to "All Resources", admin_resources_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_resources_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
              <%= link_to "+ Add Resource", new_admin_resource_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white" %>
            </div>
          </div>

          <!-- 5. USERS / TEAM MEMBERS (COLLAPSIBLE) -->
          <div class="space-y-1">
            <button type="button" data-action="click->admin-sidebar#toggleSection" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-colors text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none">
              <div class="flex items-center gap-3">
                <span class="text-base">👥</span>
                <span>Users</span>
              </div>
              <svg class="chevron-icon w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="pl-9 pr-2 space-y-1">
              <%= link_to "All Team Members", admin_users_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_users_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
              <%= link_to "+ Add Team Member", new_admin_user_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white" %>
            </div>
          </div>

          <!-- 6. SUPPORT REQUESTS (COLLAPSIBLE) -->
          <div class="space-y-1">
            <button type="button" data-action="click->admin-sidebar#toggleSection" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-colors text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none">
              <div class="flex items-center gap-3">
                <span class="text-base">💌</span>
                <span>Support Requests</span>
              </div>
              <svg class="chevron-icon w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="pl-9 pr-2 space-y-1">
              <%= link_to "All Support Requests", admin_support_requests_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_support_requests_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
            </div>
          </div>

          <!-- INQUIRIES & APPLICATIONS (COLLAPSIBLE) -->
          <div class="space-y-1 pt-2 border-t border-slate-800/80">
            <button type="button" data-action="click->admin-sidebar#toggleSection" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-colors text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none">
              <div class="flex items-center gap-3">
                <span class="text-base">📋</span>
                <span>Inquiries & Engagement</span>
              </div>
              <svg class="chevron-icon w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="pl-9 pr-2 space-y-1">
              <%= link_to "Contact Inquiries", admin_contact_inquiries_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_contact_inquiries_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
              <%= link_to "Volunteer Applications", admin_volunteer_applications_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_volunteer_applications_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
              <%= link_to "Partnerships", admin_partnership_inquiries_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_partnership_inquiries_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
              <%= link_to "Donations", admin_donations_path, class: "block px-3 py-1.5 rounded-lg text-xs font-medium #{current_page?(admin_donations_path) ? 'text-plum-300 font-bold bg-slate-850' : 'text-slate-400 hover:text-white'}" %>
            </div>
          </div>
        </nav>

        <div class="px-4 pt-4 border-t border-slate-800">
          <%= link_to root_path, target: "_blank", class: "flex items-center justify-center gap-2 px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs font-bold text-slate-300 hover:text-white hover:border-slate-700 transition-colors" do %>
            <span>🌐</span>
            <span>View Public Website</span>
          <% end %>
        </div>
      </aside>

      <!-- MOBILE OVERLAY SIDEBAR DRAWER -->
      <div data-admin-sidebar-target="mobileSidebar" class="hidden fixed inset-0 z-50 lg:hidden">
        <div data-action="click->admin-sidebar#closeMobile" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm"></div>

        <aside class="relative flex flex-col w-72 max-w-full h-full bg-slate-900 border-r border-slate-800 p-6 overflow-y-auto">
          <div class="flex items-center justify-between pb-6 border-b border-slate-800 mb-6">
            <div class="flex items-center gap-3">
              <%= image_tag "logo.png", alt: "Connecting Hearts Logo", class: "h-9 w-auto object-contain brightness-0 invert" %>
              <div>
                <span class="font-serif font-bold text-sm text-white block">Connecting Hearts</span>
                <span class="text-[10px] text-plum-300 font-medium">Foundation Admin</span>
              </div>
            </div>
            <button type="button" data-action="click->admin-sidebar#closeMobile" class="p-2 text-slate-400 hover:text-white">
              ✕
            </button>
          </div>

          <nav class="space-y-3 flex-1 text-xs">
            <%= link_to "📊 Dashboard", admin_dashboard_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "📅 Events", admin_events_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "📖 Stories", admin_stories_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "📚 Resources", admin_resources_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "👥 Users (Team Members)", admin_users_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "💌 Support Requests", admin_support_requests_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "✉ Contact Inquiries", admin_contact_inquiries_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "🤝 Volunteer Applications", admin_volunteer_applications_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "🏢 Partnerships", admin_partnership_inquiries_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
            <%= link_to "💳 Donations", admin_donations_path, data: { action: "click->admin-sidebar#closeMobile" }, class: "block p-3 rounded-xl font-bold bg-slate-950 text-white" %>
          </nav>
        </aside>
      </div>
    <% end %>

    <!-- MAIN CONTENT AREA -->
    <main class="<%= logged_in? ? 'lg:pl-64 pt-20 pb-12' : 'py-12' %> min-h-screen transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <%= render "layouts/flash" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
