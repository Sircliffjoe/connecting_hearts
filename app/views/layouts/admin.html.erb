<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900">
  <head>
    <title>Admin Dashboard | Connecting Hearts Foundation</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex flex-col min-h-screen bg-slate-950 text-slate-100 font-sans antialiased">
    <% if logged_in? %>
      <header class="bg-slate-900 border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center space-x-4">
              <%= link_to admin_dashboard_path, class: "font-serif font-bold text-lg text-white flex items-center gap-2" do %>
                <span class="w-8 h-8 rounded-full brand-btn-gradient flex items-center justify-center text-sm">♥</span>
                <span>Foundation Admin</span>
              <% end %>
            </div>

            <nav class="hidden md:flex items-center space-x-2 text-xs font-semibold text-slate-300">
              <%= link_to "Dashboard", admin_dashboard_path, class: "hover:text-white px-3 py-2 rounded-md #{'bg-slate-800 text-white' if current_page?(admin_dashboard_path)}" %>
              <%= link_to "Contact Inquiries", admin_contact_inquiries_path, class: "hover:text-white px-3 py-2 rounded-md #{'bg-slate-800 text-white' if current_page?(admin_contact_inquiries_path)}" %>
              <%= link_to "Support Requests", admin_support_requests_path, class: "hover:text-white px-3 py-2 rounded-md #{'bg-slate-800 text-white' if current_page?(admin_support_requests_path)}" %>
              <%= link_to "Volunteers", admin_volunteer_applications_path, class: "hover:text-white px-3 py-2 rounded-md #{'bg-slate-800 text-white' if current_page?(admin_volunteer_applications_path)}" %>
              <%= link_to "Partnerships", admin_partnership_inquiries_path, class: "hover:text-white px-3 py-2 rounded-md #{'bg-slate-800 text-white' if current_page?(admin_partnership_inquiries_path)}" %>
              <%= link_to "Events", admin_events_path, class: "hover:text-white px-3 py-2 rounded-md #{'bg-slate-800 text-white' if current_page?(admin_events_path)}" %>
              <%= link_to "Stories", admin_stories_path, class: "hover:text-white px-3 py-2 rounded-md #{'bg-slate-800 text-white' if current_page?(admin_stories_path)}" %>
              <%= link_to "Resources", admin_resources_path, class: "hover:text-white px-3 py-2 rounded-md #{'bg-slate-800 text-white' if current_page?(admin_resources_path)}" %>
            </nav>

            <div class="flex items-center space-x-3 text-xs">
              <span class="text-slate-400">👤 <%= current_user.name %></span>
              <%= link_to "Public Site", root_path, target: "_blank", class: "text-slate-400 hover:text-white underline" %>
              <%= button_to "Logout", admin_logout_path, method: :delete, class: "px-3 py-1.5 bg-rose-900/80 hover:bg-rose-800 text-rose-100 rounded-md font-semibold cursor-pointer" %>
            </div>
          </div>
        </div>
      </header>
    <% end %>

    <%= render "layouts/flash" %>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>
  </body>
</html>
