<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 header-transparent" data-controller="header menu">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-22">
      
      <!-- Brand Logo -->
      <%= link_to root_path, class: "flex items-center gap-3 group" do %>
        <%= image_tag "logo.png", alt: "Connecting Hearts Logo", class: "h-11 w-auto object-contain group-hover:scale-105 transition-transform drop-shadow" %>
        <div class="flex flex-col">
          <span class="font-serif font-extrabold text-lg sm:text-xl header-text-main tracking-tight leading-tight transition-colors">Connecting Hearts</span>
        </div>
      <% end %>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center space-x-1">
        
        <!-- Mega Menu 1: About Us -->
        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle" class="px-3.5 py-2 rounded-xl text-sm font-bold header-nav-btn transition-colors flex items-center gap-1.5 focus:outline-none">
            <span>About Us</span>
            <svg class="w-4 h-4 header-nav-icon transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <!-- Spacious Mega Menu -->
          <div data-dropdown-target="menu" class="hidden absolute left-0 mt-3 w-[640px] bg-white rounded-3xl shadow-2xl border border-warm-300 p-6 z-50 animate-fade-in grid grid-cols-12 gap-6">
            <div class="col-span-7 space-y-3">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-plum-700 block border-b border-warm-200 pb-2">Discover Our Story</span>
              
              <%= link_to about_path, class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-plum-100 text-plum-700 flex items-center justify-center font-bold text-base group-hover:bg-plum-700 group-hover:text-white transition-colors">🏛️</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">About The Foundation</div>
                  <div class="text-xs text-charcoal-500">Our history, founding vision by Eloho Sodje, and Warri roots.</div>
                </div>
              <% end %>

              <%= link_to about_path(anchor: "vision"), class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-terracotta-100 text-terracotta-700 flex items-center justify-center font-bold text-base group-hover:bg-terracotta-600 group-hover:text-white transition-colors">🎯</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">Vision & Mission</div>
                  <div class="text-xs text-charcoal-500">Connecting hearts, restoring hope, and building resilient families.</div>
                </div>
              <% end %>

              <%= link_to about_path(anchor: "leadership"), class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-base group-hover:bg-emerald-600 group-hover:text-white transition-colors">🤝</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">Leadership & Team</div>
                  <div class="text-xs text-charcoal-500">Meet Eloho Sodje, Pastor Anthony Sodje, and our volunteer counselors.</div>
                </div>
              <% end %>
            </div>

            <div class="col-span-5 bg-gradient-to-br from-plum-900 via-plum-800 to-plum-950 text-white rounded-2xl p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-widest text-terracotta-300 bg-white/10 px-2.5 py-1 rounded-full inline-block">Established 2025</span>
                <h4 class="font-serif font-bold text-base text-white">Institutional Support for Families</h4>
                <p class="text-xs text-plum-100/90 leading-relaxed">Providing ongoing therapy, crisis mediation, and education across Nigeria.</p>
              </div>
              <%= link_to "Learn More →", about_path, class: "text-xs font-bold text-terracotta-300 hover:text-white transition-colors" %>
            </div>
          </div>
        </div>

        <!-- Mega Menu 2: What We Do -->
        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle" class="px-3.5 py-2 rounded-xl text-sm font-bold header-nav-btn transition-colors flex items-center gap-1.5 focus:outline-none">
            <span>What We Do</span>
            <svg class="w-4 h-4 header-nav-icon transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <!-- Spacious Mega Menu -->
          <div data-dropdown-target="menu" class="hidden absolute left-0 mt-3 w-[680px] bg-white rounded-3xl shadow-2xl border border-warm-300 p-6 z-50 animate-fade-in grid grid-cols-12 gap-6">
            <div class="col-span-7 space-y-3">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-plum-700 block border-b border-warm-200 pb-2">Our Three Foundation Pillars</span>
              
              <%= link_to experiences_path, class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-base group-hover:bg-purple-700 group-hover:text-white transition-colors">🎤</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">Connecting Hearts Experience</div>
                  <div class="text-xs text-charcoal-500">Conferences, panel debates, and open conversations for singles & married.</div>
                </div>
              <% end %>

              <%= link_to counseling_path, class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-base group-hover:bg-emerald-600 group-hover:text-white transition-colors">💚</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">Free Counseling & Therapy</div>
                  <div class="text-xs text-charcoal-500">Confidential guidance for couples, grief, divorce, and relationship conflict.</div>
                </div>
              <% end %>

              <%= link_to educational_support_path, class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-base group-hover:bg-amber-600 group-hover:text-white transition-colors">📚</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">Educational Support for Children</div>
                  <div class="text-xs text-charcoal-500">School fee subsidies for children from broken and single-parent homes.</div>
                </div>
              <% end %>
            </div>

            <div class="col-span-5 bg-gradient-to-br from-terracotta-600 to-terracotta-800 text-white rounded-2xl p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-widest text-white/90 bg-white/20 px-2.5 py-1 rounded-full inline-block">Need Confidential Help?</span>
                <h4 class="font-serif font-bold text-base text-white">Free Intake Consultation</h4>
                <p class="text-xs text-amber-50 leading-relaxed">Speak to a certified family counselor or therapist in confidence.</p>
              </div>
              <%= link_to new_support_request_path, class: "inline-block text-center px-4 py-2.5 text-xs font-bold text-plum-950 bg-white rounded-full shadow-md hover:bg-warm-100 transition-colors" do %>
                Request Support Now
              <% end %>
            </div>
          </div>
        </div>

        <!-- Mega Menu 3: Our Impact -->
        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle" class="px-3.5 py-2 rounded-xl text-sm font-bold header-nav-btn transition-colors flex items-center gap-1.5 focus:outline-none">
            <span>Our Impact</span>
            <svg class="w-4 h-4 header-nav-icon transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <!-- Spacious Mega Menu -->
          <div data-dropdown-target="menu" class="hidden absolute left-0 mt-3 w-[600px] bg-white rounded-3xl shadow-2xl border border-warm-300 p-6 z-50 animate-fade-in grid grid-cols-12 gap-6">
            <div class="col-span-7 space-y-3">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-plum-700 block border-b border-warm-200 pb-2">Community & Transformation</span>
              
              <%= link_to stories_path, class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-base group-hover:bg-blue-600 group-hover:text-white transition-colors">✨</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">Beneficiary & Impact Stories</div>
                  <div class="text-xs text-charcoal-500">Real stories of restored marriages and child education support.</div>
                </div>
              <% end %>

              <%= link_to experiences_path, class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center font-bold text-base group-hover:bg-rose-600 group-hover:text-white transition-colors">🏛️</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">Past Edition Archives</div>
                  <div class="text-xs text-charcoal-500">Review Experience 1.0, 2.0, and 3.0 session highlights.</div>
                </div>
              <% end %>

              <%= link_to get_involved_path, class: "flex items-start gap-3 p-2.5 rounded-2xl hover:bg-plum-50/80 transition-colors group" do %>
                <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-base group-hover:bg-indigo-600 group-hover:text-white transition-colors">🌟</div>
                <div>
                  <div class="text-sm font-bold text-plum-950 group-hover:text-plum-700">Get Involved & Volunteer</div>
                  <div class="text-xs text-charcoal-500">Give your time as a therapist, media, or event professional.</div>
                </div>
              <% end %>
            </div>

            <div class="col-span-5 bg-warm-100 border border-warm-300 rounded-2xl p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-widest text-plum-700 bg-plum-100 px-2.5 py-1 rounded-full inline-block">Impact Numbers</span>
                <div class="text-2xl font-serif font-extrabold text-plum-950">100+</div>
                <p class="text-xs text-charcoal-600 leading-relaxed">Attendees per experience edition seeking relationship growth in Delta State.</p>
              </div>
              <%= link_to "View Impact Stories →", stories_path, class: "text-xs font-bold text-plum-700 hover:text-plum-950 transition-colors" %>
            </div>
          </div>
        </div>

        <!-- Standalone Links (Resources & Contact Us - Request 3) -->
        <%= link_to "Resources", resources_path, class: "px-3.5 py-2 rounded-xl text-sm font-bold header-nav-btn transition-colors" %>
        <%= link_to "Contact Us", contact_path, class: "px-3.5 py-2 rounded-xl text-sm font-bold header-nav-btn transition-colors" %>

      </nav>

      <!-- Action Buttons -->
      <div class="hidden lg:flex items-center space-x-3">
        <%= link_to new_partnership_inquiry_path, class: "px-4 py-2.5 text-xs font-bold rounded-full transition-all border header-btn-secondary" do %>
          Partner with us
        <% end %>
        <%= link_to new_support_request_path, class: "px-5 py-2.5 text-xs font-bold text-white brand-btn-gradient rounded-full shadow-md hover:shadow-lg transition-all flex items-center gap-1.5" do %>
          <span>Get support</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        <% end %>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center lg:hidden space-x-2">
        <%= link_to "Get support", new_support_request_path, class: "px-3 py-1.5 text-xs font-bold text-white brand-btn-gradient rounded-full" %>
        <button type="button" data-action="click->menu#toggle" class="p-2.5 rounded-lg header-hamburger transition-colors focus:outline-none" aria-label="Toggle Navigation Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div data-menu-target="drawer" class="hidden lg:hidden bg-white border-b border-warm-300 px-4 pt-3 pb-6 space-y-4 shadow-2xl">
    
    <!-- About Us Group -->
    <div class="space-y-1">
      <div class="text-[11px] font-bold uppercase tracking-wider text-plum-700 px-3 py-1">About Us</div>
      <%= link_to "About The Foundation", about_path, class: "block px-4 py-2 rounded-lg text-sm font-semibold text-charcoal-800 hover:bg-plum-50", data: { action: "click->menu#close" } %>
    </div>

    <!-- What We Do Group -->
    <div class="space-y-1 border-t border-warm-200 pt-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-plum-700 px-3 py-1">What We Do</div>
      <%= link_to "Connecting Hearts Experience", experiences_path, class: "block px-4 py-2 rounded-lg text-sm font-semibold text-charcoal-800 hover:bg-plum-50", data: { action: "click->menu#close" } %>
      <%= link_to "Free Counseling & Therapy", counseling_path, class: "block px-4 py-2 rounded-lg text-sm font-semibold text-charcoal-800 hover:bg-plum-50", data: { action: "click->menu#close" } %>
      <%= link_to "Educational Support for Children", educational_support_path, class: "block px-4 py-2 rounded-lg text-sm font-semibold text-charcoal-800 hover:bg-plum-50", data: { action: "click->menu#close" } %>
    </div>

    <!-- Our Impact & Standalone Links -->
    <div class="space-y-1 border-t border-warm-200 pt-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-plum-700 px-3 py-1">Impact & Media</div>
      <%= link_to "Impact Stories", stories_path, class: "block px-4 py-2 rounded-lg text-sm font-semibold text-charcoal-800 hover:bg-plum-50", data: { action: "click->menu#close" } %>
      <%= link_to "Resources & Articles", resources_path, class: "block px-4 py-2 rounded-lg text-sm font-semibold text-charcoal-800 hover:bg-plum-50", data: { action: "click->menu#close" } %>
      <%= link_to "Contact Us", contact_path, class: "block px-4 py-2 rounded-lg text-sm font-semibold text-charcoal-800 hover:bg-plum-50", data: { action: "click->menu#close" } %>
      <%= link_to "Get Involved / Volunteer", get_involved_path, class: "block px-4 py-2 rounded-lg text-sm font-semibold text-charcoal-800 hover:bg-plum-50", data: { action: "click->menu#close" } %>
    </div>

    <div class="pt-4 border-t border-warm-300 flex flex-col gap-2">
      <%= link_to "Get support", new_support_request_path, class: "w-full text-center px-4 py-3 font-bold text-white brand-btn-gradient rounded-xl shadow-md" %>
      <%= link_to "Partner with us", new_partnership_inquiry_path, class: "w-full text-center px-4 py-3 font-bold text-plum-950 bg-warm-200 rounded-xl border border-warm-300" %>
    </div>

  </div>
</header>
