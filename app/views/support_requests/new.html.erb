<% content_for :title, "Request Confidential Support" %>

<section class="bg-plum-950 text-white py-12 lg:py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-3">
    <span class="text-xs font-bold uppercase tracking-widest text-terracotta-300">100% Confidential & Safe</span>
    <h1 class="font-serif text-3xl sm:text-4xl font-bold">Request Support</h1>
    <p class="text-sm text-warm-200/90 font-light max-w-xl mx-auto">
      Please complete this compassionate, confidential request form. Our support team will review your information with utmost dignity.
    </p>
  </div>
</section>

<section class="py-12 bg-warm-50" data-controller="multistep">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">

    <!-- Progress Indicator Dots -->
    <div class="flex items-center justify-between mb-8 px-4">
      <div class="flex items-center gap-2">
        <span data-multistep-target="indicator" class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs bg-plum-800 text-white">1</span>
        <span class="text-xs font-semibold hidden sm:inline text-charcoal-700">Category</span>
      </div>
      <div class="h-0.5 flex-1 bg-warm-300 mx-2"></div>
      <div class="flex items-center gap-2">
        <span data-multistep-target="indicator" class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs bg-warm-200 text-charcoal-500">2</span>
        <span class="text-xs font-semibold hidden sm:inline text-charcoal-700">Situation</span>
      </div>
      <div class="h-0.5 flex-1 bg-warm-300 mx-2"></div>
      <div class="flex items-center gap-2">
        <span data-multistep-target="indicator" class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs bg-warm-200 text-charcoal-500">3</span>
        <span class="text-xs font-semibold hidden sm:inline text-charcoal-700">Contact</span>
      </div>
      <div class="h-0.5 flex-1 bg-warm-300 mx-2"></div>
      <div class="flex items-center gap-2">
        <span data-multistep-target="indicator" class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs bg-warm-200 text-charcoal-500">4</span>
        <span class="text-xs font-semibold hidden sm:inline text-charcoal-700">Submit</span>
      </div>
    </div>

    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-warm-300 shadow-sm">
      <%= form_with(model: @support_request, local: true, class: "space-y-6") do |f| %>
        <%= render "shared/spam_protection_fields" %>

        <% if @support_request.errors.any? %>
          <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-900 space-y-1">
            <p class="font-bold">We couldn't submit your request right now. Please check the errors below:</p>
            <ul class="list-disc list-inside">
              <% @support_request.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- STEP 1: Support Category & Format -->
        <div data-multistep-target="step" class="space-y-6">
          <div class="border-b border-warm-200 pb-4">
            <h2 class="font-serif text-2xl font-bold text-plum-950">Step 1: Select Type of Support</h2>
            <p class="text-xs text-charcoal-500">What kind of assistance do you or your family require?</p>
          </div>

          <div class="space-y-2">
            <%= f.label :support_category, "Support Category", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
            <%= f.select :support_category, SupportRequest::CATEGORIES, {}, class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
          </div>

          <div class="space-y-2">
            <%= f.label :session_format, "Preferred Format", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
            <%= f.select :session_format, SupportRequest::FORMATS, {}, class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
          </div>

          <div class="pt-4 flex justify-end">
            <button type="button" data-action="click->multistep#next" class="px-6 py-3 text-xs font-bold text-white bg-plum-900 hover:bg-plum-800 rounded-full shadow-md">
              Continue to Step 2 →
            </button>
          </div>
        </div>

        <!-- STEP 2: Situation Description -->
        <div data-multistep-target="step" class="space-y-6 hidden">
          <div class="border-b border-warm-200 pb-4">
            <h2 class="font-serif text-2xl font-bold text-plum-950">Step 2: Tell Us A Little About Your Situation</h2>
            <p class="text-xs text-charcoal-500">Share as much or as little detail as you feel comfortable sharing.</p>
          </div>

          <div class="space-y-2">
            <%= f.label :situation_description, "Brief Description of Support Needed", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
            <%= f.text_area :situation_description, rows: 5, placeholder: "e.g. My spouse and I are struggling with communication, or I need educational fee support for my 10-year-old child...", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
          </div>

          <div class="pt-4 flex justify-between">
            <button type="button" data-action="click->multistep#previous" class="px-6 py-3 text-xs font-bold text-charcoal-700 bg-warm-200 hover:bg-warm-300 rounded-full">
              ← Back
            </button>
            <button type="button" data-action="click->multistep#next" class="px-6 py-3 text-xs font-bold text-white bg-plum-900 hover:bg-plum-800 rounded-full shadow-md">
              Continue to Step 3 →
            </button>
          </div>
        </div>

        <!-- STEP 3: Contact Preferences -->
        <div data-multistep-target="step" class="space-y-6 hidden">
          <div class="border-b border-warm-200 pb-4">
            <h2 class="font-serif text-2xl font-bold text-plum-950">Step 3: How Should We Contact You?</h2>
            <p class="text-xs text-charcoal-500">Provide your contact details so our support team can reach out.</p>
          </div>

          <div class="space-y-2">
            <%= f.label :full_name, "Full Name", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
            <%= f.text_field :full_name, placeholder: "Your name", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2">
              <%= f.label :email, "Email Address", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
              <%= f.email_field :email, placeholder: "you@example.com", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
            </div>
            <div class="space-y-2">
              <%= f.label :phone, "Phone / WhatsApp Number", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
              <%= f.telephone_field :phone, placeholder: "08012345678", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
            </div>
          </div>

          <div class="space-y-2">
            <%= f.label :preferred_contact_method, "Preferred Contact Method", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
            <%= f.select :preferred_contact_method, ["Email", "WhatsApp", "Phone Call"], {}, class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
          </div>

          <div class="pt-4 flex justify-between">
            <button type="button" data-action="click->multistep#previous" class="px-6 py-3 text-xs font-bold text-charcoal-700 bg-warm-200 hover:bg-warm-300 rounded-full">
              ← Back
            </button>
            <button type="button" data-action="click->multistep#next" class="px-6 py-3 text-xs font-bold text-white bg-plum-900 hover:bg-plum-800 rounded-full shadow-md">
              Continue to Step 4 →
            </button>
          </div>
        </div>

        <!-- STEP 4: Consent & Submission -->
        <div data-multistep-target="step" class="space-y-6 hidden">
          <div class="border-b border-warm-200 pb-4">
            <h2 class="font-serif text-2xl font-bold text-plum-950">Step 4: Consent & Final Submission</h2>
            <p class="text-xs text-charcoal-500">Review your privacy choice before submitting.</p>
          </div>

          <div class="bg-warm-100 p-4 rounded-xl border border-warm-300 space-y-3">
            <label class="flex items-start gap-3 cursor-pointer">
              <%= f.check_box :consent_given, class: "mt-1 rounded text-plum-900 focus:ring-plum-800" %>
              <span class="text-xs text-charcoal-700 leading-relaxed">
                I agree to allow Connecting Hearts Foundation support personnel to contact me regarding this request. I understand that my information is kept strictly confidential and will never be shared publicly.
              </span>
            </label>
          </div>

          <div class="pt-4 flex justify-between items-center">
            <button type="button" data-action="click->multistep#previous" class="px-6 py-3 text-xs font-bold text-charcoal-700 bg-warm-200 hover:bg-warm-300 rounded-full">
              ← Back
            </button>
            <%= f.submit "Submit Request With Care", class: "px-8 py-4 text-xs font-bold text-white bg-plum-900 hover:bg-plum-800 rounded-full shadow-lg cursor-pointer" %>
          </div>
        </div>

      <% end %>
    </div>
  </div>
</section>
