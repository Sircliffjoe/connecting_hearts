<% content_for :title, "Support Request Received" %>

<section class="py-20 bg-warm-50 min-h-[70vh] flex items-center justify-center">
  <div class="max-w-xl mx-auto px-4 text-center">
    <div class="bg-white rounded-3xl p-10 border border-warm-300 shadow-md space-y-6">
      
      <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-3xl font-bold mx-auto">
        ✓
      </div>

      <h1 class="font-serif text-3xl font-bold text-plum-950">Thank You For Reaching Out</h1>
      
      <p class="text-sm text-charcoal-700 leading-relaxed font-sans">
        Your request has been received with complete confidentiality and care. A member of the appropriate Connecting Hearts support team in Warri will review your request and contact you via your preferred method with next steps.
      </p>

      <div class="p-4 rounded-xl bg-warm-100 border border-warm-300 text-xs text-charcoal-600 italic">
        "You do not have to face this journey alone. Help is possible."
      </div>

      <div class="pt-4">
        <%= link_to "Return To Home", root_path, class: "inline-block px-8 py-3.5 text-xs font-bold text-white bg-plum-900 hover:bg-plum-800 rounded-full shadow-sm transition-all" %>
      </div>

    </div>
  </div>
</section>
