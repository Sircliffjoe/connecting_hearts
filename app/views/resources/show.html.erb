<% content_for :title, @resource.title %>
<% content_for :description, @resource.summary.presence || @resource.content.to_s.truncate(160) %>
<% content_for :og_type, "article" %>

<!-- Hero Header (Harmonized) -->
<section class="brand-gradient text-white pt-28 pb-16 text-center relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 relative z-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-amber-300 uppercase">
      <span><%= @resource.category %> • <%= @resource.resource_type %></span>
    </div>
    <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white max-w-4xl mx-auto leading-tight"><%= @resource.title %></h1>
    <p class="text-base text-purple-100/90 max-w-2xl mx-auto font-sans font-light italic">
      "<%= @resource.summary %>"
    </p>
  </div>
</section>

<section class="py-16 bg-warm-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-10">
    
    <!-- Main Featured Image -->
    <div class="rounded-3xl overflow-hidden shadow-lg border-4 border-white max-h-96">
      <img src="<%= safe_image_path(@resource.main_image) %>" alt="<%= @resource.title %> main feature photo" class="w-full h-full object-cover">
    </div>

    <!-- Article Content -->
    <div class="bg-white p-8 sm:p-12 rounded-3xl border border-warm-300 shadow-sm text-charcoal-800 leading-relaxed font-sans space-y-6 text-base">
      <div class="flex items-center justify-between border-b border-warm-200 pb-4 text-xs font-semibold text-charcoal-500">
        <span>Category: <strong class="text-plum-950 font-bold"><%= @resource.category %></strong></span>
        <span>Format: <strong class="text-plum-950 font-bold"><%= @resource.resource_type %></strong></span>
      </div>

      <div class="prose max-w-none text-charcoal-800 space-y-4 font-normal">
        <%= simple_format(@resource.content) %>
      </div>

      <% if @resource.file_url.present? || @resource.external_link.present? %>
        <div class="pt-6 border-t border-warm-200 flex flex-wrap gap-4">
          <% if @resource.file_url.present? %>
            <a href="<%= @resource.file_url %>" target="_blank" class="px-6 py-3 text-xs font-bold text-white brand-btn-gradient rounded-xl shadow-xs">
              📥 Download Document / Guide
            </a>
          <% end %>
          <% if @resource.external_link.present? %>
            <a href="<%= @resource.external_link %>" target="_blank" class="px-6 py-3 text-xs font-bold text-plum-950 bg-warm-200 hover:bg-warm-300 rounded-xl">
              🔗 External Link / Video Stream
            </a>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Resource Photo Gallery (4 Grid Images) -->
    <% if @resource.extra_images.present? %>
      <div class="bg-white p-8 sm:p-10 rounded-3xl border border-warm-300 shadow-xs space-y-6">
        <div class="border-b border-warm-200 pb-3">
          <span class="text-xs font-bold uppercase tracking-widest text-plum-700">Visual Insights</span>
          <h3 class="font-serif text-2xl font-bold text-plum-950">Resource Gallery & Visual Highlights</h3>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <% @resource.extra_images.first(4).each_with_index do |img, idx| %>
            <div class="rounded-2xl overflow-hidden h-36 border border-warm-300 shadow-xs group">
              <img src="<%= safe_image_path(img) %>" alt="<%= @resource.title %> gallery image <%= idx + 1 %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="pt-4 text-center">
      <%= link_to "← Back To All Resources", resources_path, class: "px-8 py-3.5 text-xs font-bold text-plum-950 bg-white hover:bg-warm-200 border border-warm-300 rounded-full shadow-xs transition-colors inline-block" %>
    </div>

  </div>
</section>
