<% content_for :title, @resource.title %>
<% content_for :description, @resource.summary.presence || @resource.content.to_s.truncate(160) %>
<% content_for :og_type, "article" %>

<section class="py-24 bg-warm-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
    <div class="space-y-4 text-center">
      <div class="flex items-center justify-center gap-2">
        <span class="text-xs font-bold uppercase tracking-widest text-terracotta-700 bg-terracotta-50 px-3 py-1 rounded-full border border-terracotta-200"><%= @resource.category %></span>
        <span class="text-xs text-charcoal-400">•</span>
        <span class="text-xs font-bold text-plum-700 bg-plum-50 px-3 py-1 rounded-full"><%= @resource.resource_type %></span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-plum-950"><%= @resource.title %></h1>
    </div>

    <div class="bg-white p-8 sm:p-12 rounded-3xl border border-warm-300 shadow-sm text-charcoal-800 leading-relaxed font-sans space-y-6 text-base">
      <p class="text-lg font-serif italic text-plum-900 border-b border-warm-200 pb-4"><%= @resource.summary %></p>
      <%= simple_format(@resource.content) %>
    </div>

    <div class="pt-6 text-center">
      <%= link_to "← Back To Resources", resources_path, class: "px-6 py-3 text-xs font-bold text-plum-950 bg-warm-200 hover:bg-warm-300 rounded-full transition-colors inline-block" %>
    </div>
  </div>
</section>
