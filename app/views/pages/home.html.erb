<!-- SECTION 5: 4-WAY CALL TO ACTION GRID -->
<section class="py-20 bg-warm-50 border-t border-warm-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-plum-950">There Are Many Ways To Help & Get Involved.</h2>
      <p class="text-sm text-charcoal-700">Whether you are seeking support or want to offer your time, expertise, or resources.</p>
