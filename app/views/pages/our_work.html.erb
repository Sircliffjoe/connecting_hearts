<% content_for :title, "Our Work" %>

<section class="brand-gradient text-white pt-28 pb-20 text-center relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 relative z-10">
    <span class="text-xs font-bold uppercase tracking-widest text-terracotta-300 bg-white/10 px-3.5 py-1 rounded-full inline-block">Strategic Pillars</span>
    <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white">Our Work & Programmes</h1>
    <p class="text-lg text-purple-100/90 max-w-2xl mx-auto font-sans font-light">
      Comprehensive relationship support, professional mental health guidance, and educational protection for vulnerable children.
    </p>
  </div>
</section>


<section class="py-20 bg-warm-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    
    <!-- Pillar 1 -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <span class="inline-block bg-plum-900 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Pillar 1</span>
        <h2 class="font-serif text-3xl font-bold text-plum-950">Connecting Hearts Experience</h2>
        <p class="text-base text-charcoal-700 leading-relaxed">
          The flagship conference series that created our movement. Designed for both single and married participants, each edition addresses real-world relationship dynamics with brutal honesty and compassionate wisdom.
        </p>
        <ul class="space-y-2 text-sm text-charcoal-700">
          <li class="flex items-center gap-2">✓ Interactive Panel Debates & Q&A</li>
          <li class="flex items-center gap-2">✓ Real Testimonies & Breakout Groups</li>
          <li class="flex items-center gap-2">✓ Professional Therapy & Guidance Introductions</li>
        </ul>
        <%= link_to "View Conference Archive & Edition 4.0", experiences_path, class: "inline-block px-6 py-3 text-sm font-semibold text-white bg-plum-900 rounded-full shadow-sm hover:bg-plum-800" %>
      </div>
      <div class="lg:col-span-6">
        <img src="<%= image_path('pic20.jpeg') %>" alt="Connecting Hearts Experience" class="rounded-3xl shadow-lg border border-warm-300 w-full h-80 object-cover">
      </div>
    </div>

    <!-- Pillar 2 -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center lg:flex-row-reverse">
      <div class="lg:col-span-6 lg:order-2 space-y-6">
        <span class="inline-block bg-terracotta-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Pillar 2</span>
        <h2 class="font-serif text-3xl font-bold text-plum-950">Free Counseling & Therapy</h2>
        <p class="text-base text-charcoal-700 leading-relaxed">
          A confidential helpline and professional referral network for individuals and couples navigating marital strain, divorce grief, communication blockages, or emotional distress.
        </p>
        <ul class="space-y-2 text-sm text-charcoal-700">
          <li class="flex items-center gap-2">✓ 100% Confidential Intake Process</li>
          <li class="flex items-center gap-2">✓ Certified Family Counselors & Therapists</li>
          <li class="flex items-center gap-2">✓ Virtual & In-Person Sessions in Warri</li>
        </ul>
        <%= link_to "Request Confidential Counseling", new_support_request_path, class: "inline-block px-6 py-3 text-sm font-semibold text-white bg-terracotta-600 rounded-full shadow-sm hover:bg-terracotta-500" %>
      </div>
      <div class="lg:col-span-6 lg:order-1">
        <img src="<%= image_path('pic25.jpeg') %>" alt="Counseling Session" class="rounded-3xl shadow-lg border border-warm-300 w-full h-80 object-cover">
      </div>
    </div>

    <!-- Pillar 3 -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <span class="inline-block bg-plum-800 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Pillar 3</span>
        <h2 class="font-serif text-3xl font-bold text-plum-950">Educational Support for Children</h2>
        <p class="text-base text-charcoal-700 leading-relaxed">
          Children should never pay the price for adult relationship breakdowns. We provide school fee subsidies, textbooks, uniforms, and academic mentorship to vulnerable kids in Warri.
        </p>
        <ul class="space-y-2 text-sm text-charcoal-700">
          <li class="flex items-center gap-2">✓ Tuition & School Material Grants</li>
          <li class="flex items-center gap-2">✓ Academic Mentorship & Welfare Checks</li>
          <li class="flex items-center gap-2">✓ Partnering with Verified Schools in Delta State</li>
        </ul>
        <%= link_to "Learn More & Sponsor a Child", educational_support_path, class: "inline-block px-6 py-3 text-sm font-semibold text-white bg-plum-900 rounded-full shadow-sm hover:bg-plum-800" %>
      </div>
      <div class="lg:col-span-6">
        <img src="<%= image_path('pic30.jpeg') %>" alt="Children in School" class="rounded-3xl shadow-lg border border-warm-300 w-full h-80 object-cover">
      </div>
    </div>

  </div>
</section>
