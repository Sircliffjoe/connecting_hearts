<% content_for :title, "Volunteer Application Received" %>

<section class="py-20 bg-warm-50 min-h-[60vh] flex items-center justify-center">
  <div class="max-w-md mx-auto px-4 text-center">
    <div class="bg-white rounded-3xl p-8 border border-warm-300 shadow-md space-y-6">
      <div class="w-16 h-16 rounded-full bg-plum-100 text-plum-900 flex items-center justify-center text-3xl font-bold mx-auto">
        🙌
      </div>

      <h1 class="font-serif text-2xl font-bold text-plum-950">Thank You For Volunteering!</h1>
      
      <p class="text-xs text-charcoal-700 leading-relaxed font-sans">
        We are thrilled by your desire to lend your skills to Connecting Hearts Foundation. Our volunteer coordinator will review your application and reach out shortly.
      </p>

      <%= link_to "Return To Home", root_path, class: "inline-block px-8 py-3 text-xs font-bold text-white bg-plum-900 rounded-full" %>
    </div>
  </div>
</section>
