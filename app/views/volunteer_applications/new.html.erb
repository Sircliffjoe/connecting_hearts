<% content_for :title, "Volunteer Application" %>

<section class="bg-plum-950 text-white py-12 lg:py-16 text-center">
  <div class="max-w-3xl mx-auto px-4 space-y-3">
    <span class="text-xs font-bold uppercase tracking-widest text-terracotta-300">Give Your Time & Talents</span>
    <h1 class="font-serif text-3xl sm:text-4xl font-bold">Apply To Volunteer</h1>
    <p class="text-sm text-warm-200/90 font-light max-w-xl mx-auto">
      Join our Connect Team ecosystem of counselors, media creatives, event coordinators, and administrative support.
    </p>
  </div>
</section>

<section class="py-12 bg-warm-50">
  <div class="max-w-2xl mx-auto px-4">
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-warm-300 shadow-sm">
      <%= form_with(model: @volunteer_application, local: true, class: "space-y-6") do |f| %>
        <%= render "shared/spam_protection_fields" %>

        <% if @volunteer_application.errors.any? %>
          <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-900 space-y-1">
            <p class="font-bold">Please correct the errors below:</p>
            <ul class="list-disc list-inside">
              <% @volunteer_application.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-2">
          <%= f.label :full_name, "Full Name", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
          <%= f.text_field :full_name, required: true, placeholder: "e.g. Eloho Sodje", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <%= f.label :email, "Email Address", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
            <%= f.email_field :email, required: true, placeholder: "you@example.com", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
          </div>

          <div class="space-y-2">
            <%= f.label :phone, "Phone / WhatsApp", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
            <%= f.telephone_field :phone, placeholder: "08012345678", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
          </div>
        </div>

        <div class="space-y-2">
          <%= f.label :role_interest, "Volunteer Role Interest", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
          <%= f.select :role_interest, VolunteerApplication::ROLES, {}, class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
        </div>

        <div class="space-y-2">
          <%= f.label :skills, "Relevant Skills & Experience", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
          <%= f.text_area :skills, rows: 3, placeholder: "Briefly tell us about your background or qualifications...", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
        </div>

        <div class="space-y-2">
          <%= f.label :availability, "Availability", class: "block text-xs font-bold uppercase tracking-wider text-charcoal-700" %>
          <%= f.select :availability, ["Weekends Only", "Weekdays", "Event-based (Warri)", "Remote / Virtual"], {}, class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-800 outline-none text-sm bg-warm-50" %>
        </div>

        <%= f.submit "Submit Volunteer Application", class: "w-full py-4 text-sm font-bold text-white bg-plum-900 hover:bg-plum-800 rounded-full shadow-md cursor-pointer transition-all" %>

      <% end %>
    </div>
  </div>
</section>
