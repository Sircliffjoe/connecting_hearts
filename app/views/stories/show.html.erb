<% content_for :title, @story.title %>
<% content_for :description, @story.summary.presence || @story.body.truncate(160) %>
<% content_for :og_image, safe_image_path(@story.image_url) if @story.image_url.present? %>
<% content_for :og_type, "article" %>

<!-- Hero Header (Harmonized) -->
<section class="brand-gradient text-white pt-28 pb-16 text-center relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 relative z-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-amber-300 uppercase">
      <span><%= @story.category %> • Published <%= @story.created_at.strftime("%B %d, %Y") %></span>
    </div>
    <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white max-w-4xl mx-auto leading-tight"><%= @story.title %></h1>
  </div>
</section>

<section class="py-16 bg-warm-50">

    <% if @story.image_url.present? %>
      <div class="rounded-3xl overflow-hidden shadow-lg border border-warm-300">
        <img src="<%= safe_image_path(@story.image_url) %>" alt="<%= @story.title %>" class="w-full h-96 object-cover">
      </div>
    <% end %>

    <div class="bg-white p-8 sm:p-12 rounded-3xl border border-warm-300 shadow-sm text-charcoal-800 leading-relaxed font-sans space-y-6 text-base">
      <%= simple_format(@story.body) %>
    </div>

    <div class="pt-6 text-center">
      <%= link_to "← Back To All Stories", stories_path, class: "px-6 py-3 text-xs font-bold text-plum-900 bg-warm-200 rounded-full" %>
    </div>
  </div>
</section>
