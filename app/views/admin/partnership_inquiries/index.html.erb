<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Partnership Proposals</h1>
      <p class="text-xs text-slate-400">Review institutional sponsorships, CSR, and organizational collaboration proposals</p>
    </div>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Organization</th>
            <th class="p-3">Contact Person</th>
            <th class="p-3">Type</th>
            <th class="p-3">Email & Phone</th>
            <th class="p-3">Message</th>
            <th class="p-3">Status</th>
            <th class="p-3">Date</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% if @partnership_inquiries.any? %>
            <% @partnership_inquiries.each do |p| %>
              <tr class="hover:bg-slate-850">
                <td class="p-3 font-semibold text-white"><%= p.organization_name %></td>
                <td class="p-3"><%= p.contact_person %></td>
                <td class="p-3 font-bold text-amber-300"><%= p.partnership_type %></td>
                <td class="p-3"><%= p.email %><br><span class="text-slate-400"><%= p.phone %></span></td>
                <td class="p-3 max-w-xs truncate text-slate-400"><%= p.message %></td>
                <td class="p-3">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= p.status == 'pending' ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-emerald-950 text-emerald-300 border border-emerald-800' %>">
                    <%= p.status %>
                  </span>
                </td>
                <td class="p-3 whitespace-nowrap"><%= p.created_at.strftime("%b %d, %Y") %></td>
                <td class="p-3 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <a href="mailto:<%= p.email %>?subject=Re: Partnership Proposal - <%= ERB::Util.html_escape(p.organization_name) %>" class="p-2 rounded-lg bg-indigo-950/60 text-indigo-400 border border-indigo-800/60 hover:bg-indigo-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center" title="Email Organization" aria-label="Email Organization">
                      <%= icon_mail %>
                    </a>
                    <%= button_to admin_partnership_inquiry_path(p), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this partnership proposal from #{p.organization_name}?" }, class: "p-2 rounded-lg bg-rose-950/60 text-rose-400 border border-rose-800/60 hover:bg-rose-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center", title: "Delete Proposal", aria: { label: "Delete Proposal" } do %>
                      <%= icon_trash %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="p-8 text-center text-slate-500 italic">No partnership inquiries found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
