<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <h1 class="font-serif text-2xl font-bold text-white">Partnership Proposals</h1>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Organization</th>
            <th class="p-3">Contact Person</th>
            <th class="p-3">Type</th>
            <th class="p-3">Email & Phone</th>
            <th class="p-3">Message</th>
            <th class="p-3">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% @partnership_inquiries.each do |p| %>
            <tr class="hover:bg-slate-850">
              <td class="p-3 font-semibold text-white"><%= p.organization_name %></td>
              <td class="p-3"><%= p.contact_person %></td>
              <td class="p-3 font-bold text-purple-300"><%= p.partnership_type %></td>
              <td class="p-3"><%= p.email %><br><span class="text-slate-400"><%= p.phone %></span></td>
              <td class="p-3 max-w-xs truncate"><%= p.message %></td>
              <td class="p-3"><%= p.created_at.strftime("%b %d, %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
