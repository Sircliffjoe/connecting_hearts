<div class="space-y-6" data-controller="partnership-email">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Partnership Proposals</h1>
      <p class="text-xs text-slate-400">Review institutional sponsorships, CSR, and organizational collaboration proposals</p>
    </div>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Organization</th>
            <th class="p-3">Contact Person</th>
            <th class="p-3">Type</th>
            <th class="p-3">Email & Phone</th>
            <th class="p-3">Status</th>
            <th class="p-3">Date</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% if @partnership_inquiries.any? %>
            <% @partnership_inquiries.each do |p| %>
              <tr class="hover:bg-slate-850">
                <td class="p-3 font-semibold text-white"><%= p.organization_name %></td>
                <td class="p-3"><%= p.contact_person %></td>
                <td class="p-3 font-bold text-amber-300"><%= p.partnership_type %></td>
                <td class="p-3"><%= p.email %><br><span class="text-slate-400"><%= p.phone %></span></td>
                <td class="p-3">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= p.status == 'pending' ? 'bg-amber-950 text-amber-300 border border-amber-800' : (p.status == 'partnered' ? 'bg-emerald-950 text-emerald-300 border border-emerald-800' : 'bg-slate-800 text-slate-300 border border-slate-700') %>">
                    <%= p.status %>
                  </span>
                </td>
                <td class="p-3 whitespace-nowrap"><%= p.created_at.strftime("%b %d, %Y") %></td>
                <td class="p-3 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <%= link_to admin_partnership_inquiry_path(p), class: "p-2 rounded-lg bg-sky-950/60 text-sky-400 border border-sky-800/60 hover:bg-sky-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center", title: "View Proposal", aria: { label: "View Proposal" } do %>
                      <%= icon_eye %>
                    <% end %>
                    <button type="button"
                            data-action="click->partnership-email#open"
                            data-org="<%= ERB::Util.html_escape(p.organization_name) %>"
                            data-contact="<%= ERB::Util.html_escape(p.contact_person) %>"
                            data-email="<%= ERB::Util.html_escape(p.email) %>"
                            data-action-url="<%= send_email_admin_partnership_inquiry_path(p) %>"
                            data-subject="Re: Partnership Proposal - <%= ERB::Util.html_escape(p.organization_name) %>"
                            class="p-2 rounded-lg bg-indigo-950/60 text-indigo-400 border border-indigo-800/60 hover:bg-indigo-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center"
                            title="Email Organization"
                            aria-label="Email Organization">
                      <%= icon_mail %>
                    </button>
                    <%= button_to admin_partnership_inquiry_path(p), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this partnership proposal from #{p.organization_name}?" }, class: "p-2 rounded-lg bg-rose-950/60 text-rose-400 border border-rose-800/60 hover:bg-rose-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center", title: "Delete Proposal", aria: { label: "Delete Proposal" } do %>
                      <%= icon_trash %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="p-8 text-center text-slate-500 italic">No partnership inquiries found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- EMAIL ORGANIZATION POPUP MODAL -->
  <div data-partnership-email-target="modal" 
       data-action="click->partnership-email#closeOnBackdrop"
       class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="relative w-full max-w-lg bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-2xl space-y-5 animate-scale-up text-white">
      
      <!-- Header -->
      <div class="flex items-start justify-between border-b border-slate-800 pb-4">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-400">Direct Communication</span>
          <h3 class="font-serif text-xl font-bold text-white mt-0.5">Email Organization</h3>
        </div>
        <button type="button" 
                data-action="click->partnership-email#close" 
                class="p-2 text-slate-400 hover:text-white text-xl font-bold rounded-xl hover:bg-slate-800 transition-colors cursor-pointer"
                aria-label="Close modal">
          ✕
        </button>
      </div>

      <!-- Recipient Info Banner -->
      <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 text-xs space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Recipient</span>
          <span class="font-mono text-indigo-300" data-partnership-email-target="recipientEmail">-</span>
        </div>
        <div class="font-bold text-white text-sm" data-partnership-email-target="recipient">-</div>
      </div>

      <!-- Email Form -->
      <form data-partnership-email-target="form" method="post" class="space-y-4">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        
        <div class="space-y-1">
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300">
            Subject
          </label>
          <input type="text" 
                 name="subject" 
                 required
                 data-partnership-email-target="subject" 
                 class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none" 
                 placeholder="Subject line..." />
        </div>

        <div class="space-y-1">
          <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300">
            Message Body
          </label>
          <textarea name="message" 
                    rows="5" 
                    required
                    data-partnership-email-target="message" 
                    class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs leading-relaxed focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none" 
                    placeholder="Write your response, proposal feedback, or follow-up note here..."></textarea>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-800">
          <a href="#" 
             data-partnership-email-target="mailtoFallback" 
             class="text-xs text-indigo-400 hover:text-indigo-300 hover:underline">
            ↗ Open in Mail App
          </a>

          <div class="flex items-center gap-2">
            <button type="button" 
                    data-action="click->partnership-email#close" 
                    class="px-4 py-2 rounded-xl text-xs font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors cursor-pointer">
              Cancel
            </button>
            <button type="submit" 
                    class="px-5 py-2 rounded-xl text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-500 transition-colors shadow-md cursor-pointer flex items-center gap-2">
              <span>Send Email ✉</span>
            </button>
          </div>
        </div>
      </form>

    </div>
  </div>
</div>
