<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Manage Conferences & Events</h1>
      <p class="text-xs text-slate-400">Create, edit, and organize Connecting Hearts Experience editions and events.</p>
    </div>
    <%= link_to "+ Create New Event", new_admin_event_path, class: "px-4 py-2.5 text-xs font-bold text-white bg-plum-700 hover:bg-plum-600 rounded-xl shadow-md transition-colors" %>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <% if @events.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
            <tr>
              <th class="p-3">Edition</th>
              <th class="p-3">Event Title</th>
              <th class="p-3">Theme</th>
              <th class="p-3">Date</th>
              <th class="p-3">Location</th>
              <th class="p-3">Featured</th>
              <th class="p-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <% @events.each do |event| %>
              <tr class="hover:bg-slate-850">
                <td class="p-3 font-bold text-plum-300">Edition <%= event.edition_number %></td>
                <td class="p-3 font-semibold text-white"><%= event.title %></td>
                <td class="p-3 italic text-slate-400"><%= event.theme.presence || "—" %></td>
                <td class="p-3"><%= event.event_date&.strftime("%b %d, %Y") %></td>
                <td class="p-3"><%= event.location.presence || "Online" %></td>
                <td class="p-3"><%= event.featured ? "⭐ Yes" : "No" %></td>
                <td class="p-3 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <%= link_to admin_event_path(event), class: "p-2 rounded-lg bg-sky-950/60 text-sky-400 border border-sky-800/60 hover:bg-sky-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center", title: "View Event", aria: { label: "View Event" } do %>
                      <%= icon_eye %>
                    <% end %>
                    <%= link_to edit_admin_event_path(event), class: "p-2 rounded-lg bg-amber-950/60 text-amber-400 border border-amber-800/60 hover:bg-amber-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center", title: "Edit Event", aria: { label: "Edit Event" } do %>
                      <%= icon_pencil %>
                    <% end %>
                    <%= button_to admin_event_path(event), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this event?" }, class: "p-2 rounded-lg bg-rose-950/60 text-rose-400 border border-rose-800/60 hover:bg-rose-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center", title: "Delete Event", aria: { label: "Delete Event" } do %>
                      <%= icon_trash %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 text-slate-400 space-y-3">
        <p class="text-sm">No events found.</p>
        <%= link_to "+ Create First Event", new_admin_event_path, class: "inline-block px-4 py-2 text-xs font-bold text-white bg-plum-700 hover:bg-plum-600 rounded-xl" %>
      </div>
    <% end %>
  </div>
</div>
