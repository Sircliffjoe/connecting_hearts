<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Support Request #<%= @support_request.id %></h1>
      <p class="text-xs text-slate-400">Received <%= @support_request.created_at.strftime("%B %d, %Y at %H:%M") %></p>
    </div>
    <%= link_to "← Back to List", admin_support_requests_path, class: "text-xs font-semibold text-slate-400 hover:text-white" %>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-6 text-sm">
    <div class="grid grid-cols-2 gap-4 border-b border-slate-800 pb-4">
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Full Name</span>
        <strong class="text-white text-base"><%= @support_request.full_name %></strong>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Preferred Contact Method</span>
        <strong class="text-plum-300"><%= @support_request.preferred_contact_method %></strong>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Email</span>
        <span class="text-slate-200"><%= @support_request.email %></span>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Phone / WhatsApp</span>
        <span class="text-slate-200"><%= @support_request.phone.presence || "Not provided" %></span>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Support Category</span>
        <span class="text-amber-300 font-bold"><%= @support_request.support_category %></span>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Session Format</span>
        <span class="text-slate-200"><%= @support_request.session_format %></span>
      </div>
    </div>

    <div class="space-y-2">
      <span class="text-xs text-slate-400 block uppercase font-semibold">Situation & Needs Description</span>
      <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 text-slate-200 leading-relaxed font-sans">
        <%= simple_format(@support_request.situation_description) %>
      </div>
    </div>

    <!-- Status & Notes Form -->
    <div class="border-t border-slate-800 pt-6 space-y-4">
      <h3 class="font-serif font-bold text-white text-base">Update Status & Case Notes</h3>
      
      <%= form_with(model: [:admin, @support_request], local: true, class: "space-y-4") do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :status, "Request Status", class: "block text-xs font-semibold uppercase text-slate-400 mb-1" %>
            <%= f.select :status, SupportRequest::STATUSES, {}, class: "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs" %>
          </div>
        </div>

        <div>
          <%= f.label :notes, "Internal Counselor Notes (Private)", class: "block text-xs font-semibold uppercase text-slate-400 mb-1" %>
          <%= f.text_area :notes, rows: 3, placeholder: "Add referral details or follow-up notes...", class: "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs" %>
        </div>

        <%= f.submit "Save Status & Notes", class: "px-6 py-2.5 text-xs font-bold text-white bg-plum-800 hover:bg-plum-700 rounded-xl cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
