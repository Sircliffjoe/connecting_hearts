<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <h1 class="font-serif text-2xl font-bold text-white">Support Requests Intake Log</h1>
    <span class="text-xs text-rose-400 font-semibold bg-rose-950/60 border border-rose-800 px-3 py-1 rounded-full">
      🔒 High Safeguarding & Privacy Scoping
    </span>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">ID</th>
            <th class="p-3">Full Name</th>
            <th class="p-3">Category</th>
            <th class="p-3">Contact</th>
            <th class="p-3">Format</th>
            <th class="p-3">Status</th>
            <th class="p-3">Date</th>
            <th class="p-3">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% @support_requests.each do |sr| %>
            <tr class="hover:bg-slate-850">
              <td class="p-3 font-mono text-slate-400">#<%= sr.id %></td>
              <td class="p-3 font-semibold text-white"><%= sr.full_name %></td>
              <td class="p-3"><%= sr.support_category %></td>
              <td class="p-3"><%= sr.email %><br><span class="text-slate-400"><%= sr.phone %></span></td>
              <td class="p-3"><%= sr.session_format %></td>
              <td class="p-3">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= sr.status == 'pending' ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-emerald-950 text-emerald-300 border border-emerald-800' %>">
                  <%= sr.status %>
                </span>
              </td>
              <td class="p-3"><%= sr.created_at.strftime("%b %d, %Y") %></td>
              <td class="p-3">
                <%= link_to "Review Details", admin_support_request_path(sr), class: "text-plum-400 hover:underline font-semibold" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
