<div class="space-y-6 max-w-4xl mx-auto">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <div class="flex items-center gap-2">
        <%= link_to "← Back to Donations", admin_donations_path, class: "text-xs text-slate-400 hover:text-white" %>
      </div>
      <h1 class="font-serif text-2xl font-bold text-white mt-1">Donation File: <%= @donation.payment_reference %></h1>
      <p class="text-xs text-slate-400">Created on <%= @donation.created_at.strftime("%B %d, %Y at %H:%M %p") %></p>
    </div>

    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase <%= @donation.status_badge_class %>">
      <%= @donation.status_display_name %>
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Payment & Donor Information -->
    <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-4">
      <h2 class="font-serif text-lg font-bold text-white border-b border-slate-800 pb-3">Captured Payment Details</h2>

      <div class="space-y-3 text-xs">
        <div>
          <span class="text-slate-400 uppercase font-semibold block text-[10px]">Payment Reference</span>
          <span class="font-mono text-base font-bold text-plum-300"><%= @donation.payment_reference %></span>
        </div>

        <div class="p-3 bg-slate-950 rounded-xl border border-slate-800">
          <span class="text-slate-400 uppercase font-semibold block text-[10px]">Donation Amount</span>
          <span class="text-2xl font-serif font-bold text-emerald-400">₦<%= number_with_delimiter(@donation.amount) %></span>
          <span class="text-[10px] text-slate-400 block font-medium">Currency: NGN (Naira)</span>
        </div>

        <div>
          <span class="text-slate-400 uppercase font-semibold block text-[10px]">Donation Purpose</span>
          <span class="font-semibold text-white text-sm"><%= @donation.purpose %></span>
        </div>

        <div>
          <span class="text-slate-400 uppercase font-semibold block text-[10px]">Donor Name</span>
          <span class="font-bold text-white"><%= @donation.donor_name.presence || "Anonymous Donor" %></span>
        </div>

        <div>
          <span class="text-slate-400 uppercase font-semibold block text-[10px]">Donor Email</span>
          <span class="text-slate-200"><%= @donation.donor_email %></span>
        </div>

        <% if @donation.depositor_name.present? %>
          <div>
            <span class="text-slate-400 uppercase font-semibold block text-[10px]">Depositor / Transfer Name</span>
            <span class="font-bold text-amber-300"><%= @donation.depositor_name %></span>
          </div>
        <% end %>

        <% if @donation.notes.present? %>
          <div>
            <span class="text-slate-400 uppercase font-semibold block text-[10px]">Transfer Notes / Comments</span>
            <p class="p-3 bg-slate-950 rounded-xl border border-slate-800 text-slate-300 italic"><%= @donation.notes %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Status Control & Uploaded Receipt -->
    <div class="space-y-6">

      <!-- Update Status Card -->
      <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-4">
        <h2 class="font-serif text-lg font-bold text-white border-b border-slate-800 pb-3">Update Verification Status</h2>

        <%= form_with(model: [:admin, @donation], local: true, class: "space-y-4") do |f| %>
          <div class="space-y-2">
            <%= f.label :status, "Select Donation Status", class: "block text-xs font-bold uppercase tracking-wider text-slate-400" %>
            <%= f.select :status, [
                  ["Awaiting Payment (Pending)", "pending"],
                  ["Receipt Uploaded (Pending Verification)", "receipt_uploaded"],
                  ["Verified / Successful", "successful"],
                  ["Failed / Rejected", "failed"]
                ], {}, class: "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-xs font-bold text-white focus:ring-2 focus:ring-plum-500 outline-none" %>
          </div>

          <div class="space-y-2">
            <%= f.label :notes, "Admin Notes / Verification Remarks", class: "block text-xs font-bold uppercase tracking-wider text-slate-400" %>
            <%= f.text_area :notes, rows: 2, class: "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white focus:ring-2 focus:ring-plum-500 outline-none", placeholder: "e.g. Verified transfer in PremiumTrust Bank account statement" %>
          </div>

          <%= f.submit "Update Status", class: "w-full py-2.5 rounded-xl bg-plum-800 hover:bg-plum-700 text-white font-bold text-xs shadow cursor-pointer transition-colors" %>
        <% end %>
      </div>

      <!-- Uploaded Receipt Preview -->
      <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-4">
        <h2 class="font-serif text-lg font-bold text-white border-b border-slate-800 pb-3 flex items-center justify-between">
          <span>Uploaded Payment Receipt</span>
          <% if @donation.receipt_url.present? %>
            <a href="<%= @donation.receipt_url %>" target="_blank" class="text-xs text-emerald-400 hover:underline font-bold">Open Full File ↗</a>
          <% end %>
        </h2>

        <% if @donation.receipt_url.present? %>
          <div class="space-y-3">
            <% if @donation.receipt_url.downcase.end_with?(".pdf") %>
              <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 text-center space-y-2">
                <span class="text-4xl block">📄</span>
                <p class="text-xs font-bold text-slate-300">PDF Receipt Document</p>
                <a href="<%= @donation.receipt_url %>" target="_blank" class="inline-block px-4 py-2 rounded-xl bg-emerald-950 border border-emerald-800 text-emerald-300 text-xs font-bold hover:bg-emerald-900">
                  Open PDF Receipt
                </a>
              </div>
            <% else %>
              <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-950 p-2">
                <a href="<%= @donation.receipt_url %>" target="_blank">
                  <img src="<%= @donation.receipt_url %>" alt="Payment Receipt" class="w-full h-auto max-h-96 object-contain rounded-lg hover:opacity-95 transition-opacity" />
                </a>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-6 bg-slate-950 rounded-xl border border-slate-800 text-center text-slate-500 text-xs italic">
            No payment receipt has been uploaded by the donor yet.
          </div>
        <% end %>
      </div>

    </div>

  </div>
</div>
