<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <h1 class="font-serif text-2xl font-bold text-white">Donation Financial Log</h1>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Reference</th>
            <th class="p-3">Donor Email</th>
            <th class="p-3">Donor Name</th>
            <th class="p-3">Amount</th>
            <th class="p-3">Purpose</th>
            <th class="p-3">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% @donations.each do |d| %>
            <tr class="hover:bg-slate-850">
              <td class="p-3 font-mono text-plum-300 font-bold"><%= d.payment_reference %></td>
              <td class="p-3"><%= d.donor_email %></td>
              <td class="p-3 font-semibold text-white"><%= d.donor_name.presence || "Anonymous" %></td>
              <td class="p-3 font-bold text-emerald-400">₦<%= number_with_delimiter(d.amount) %></td>
              <td class="p-3"><%= d.purpose %></td>
              <td class="p-3"><%= d.created_at.strftime("%b %d, %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
