<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Platform & Foundation Settings</h1>
      <p class="text-xs text-slate-400">Configure foundation operational preferences and platform defaults.</p>
    </div>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 md:p-8 space-y-6 text-xs text-slate-300">
    <div class="bg-slate-950 p-6 rounded-xl border border-slate-800 space-y-4">
      <h3 class="font-bold text-white text-sm">Organization Overview</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <span class="text-slate-400 block">Foundation Name:</span>
          <span class="font-semibold text-white">Connecting Hearts for Singles & Married Foundation</span>
        </div>
        <div>
          <span class="text-slate-400 block">Location:</span>
          <span class="font-semibold text-white">Warri, Delta State, Nigeria</span>
        </div>
        <div>
          <span class="text-slate-400 block">Primary Email:</span>
          <span class="font-semibold text-white">contact@connectingheartsng.org</span>
        </div>
        <div>
          <span class="text-slate-400 block">Hotline Phone:</span>
          <span class="font-semibold text-white">+2349013732353</span>
        </div>
      </div>
    </div>

    <div class="bg-slate-950 p-6 rounded-xl border border-slate-800 space-y-3">
      <h3 class="font-bold text-white text-sm">System Diagnostics & Environment</h3>
      <p class="text-slate-400">Environment: <strong class="text-emerald-400"><%= Rails.env.to_s.upcase %></strong></p>
      <p class="text-slate-400">Rails Version: <strong class="text-white"><%= Rails.version %></strong></p>
      <p class="text-slate-400">Ruby Version: <strong class="text-white"><%= RUBY_VERSION %></strong></p>
    </div>
  </div>
</div>
