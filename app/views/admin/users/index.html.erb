<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Manage Team Members & Users</h1>
      <p class="text-xs text-slate-400">Add, view, and update foundation team members and counselors.</p>
    </div>
    <%= link_to "+ Add Team Member", new_admin_user_path, class: "px-4 py-2.5 text-xs font-bold text-white bg-plum-700 hover:bg-plum-600 rounded-xl shadow-md transition-colors" %>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <% if @users.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
            <tr>
              <th class="p-3">Name</th>
              <th class="p-3">Email</th>
              <th class="p-3">Role</th>
              <th class="p-3">Joined</th>
              <th class="p-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <% @users.each do |user| %>
              <tr class="hover:bg-slate-850">
                <td class="p-3 font-semibold text-white flex items-center gap-2.5">
                  <% if user.image_url.present? %>
                    <%= image_tag user.image_url, alt: user.name, class: "w-8 h-8 rounded-full object-cover border border-plum-500/40" %>
                  <% else %>
                    <span class="w-8 h-8 rounded-full bg-plum-800 text-plum-200 flex items-center justify-center font-bold text-xs"><%= user.name.first.upcase %></span>
                  <% end %>
                  <span><%= user.name %></span>
                </td>
                <td class="p-3 text-slate-300"><%= user.email %></td>
                <td class="p-3">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= user.role == 'super_admin' ? 'bg-purple-900/60 text-purple-300 border border-purple-700' : (user.role == 'counselor' ? 'bg-emerald-900/60 text-emerald-300 border border-emerald-700' : 'bg-plum-900/60 text-plum-300 border border-plum-700') %>">
                    <%= user.role.titleize %>
                  </span>
                </td>
                <td class="p-3"><%= user.created_at.strftime("%b %d, %Y") %></td>
                <td class="p-3 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <%= link_to admin_user_path(user), class: "p-2 rounded-lg bg-sky-950/60 text-sky-400 border border-sky-800/60 hover:bg-sky-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center", title: "View Team Member", aria: { label: "View Team Member" } do %>
                      <%= icon_eye %>
                    <% end %>
                    <%= link_to edit_admin_user_path(user), class: "p-2 rounded-lg bg-amber-950/60 text-amber-400 border border-amber-800/60 hover:bg-amber-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center", title: "Edit Team Member", aria: { label: "Edit Team Member" } do %>
                      <%= icon_pencil %>
                    <% end %>
                    <% unless user == current_user %>
                      <%= button_to admin_user_path(user), method: :delete, data: { turbo_confirm: "Are you sure you want to remove this team member?" }, class: "p-2 rounded-lg bg-rose-950/60 text-rose-400 border border-rose-800/60 hover:bg-rose-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center", title: "Delete Team Member", aria: { label: "Delete Team Member" } do %>
                        <%= icon_trash %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 text-slate-400 space-y-3">
        <p class="text-sm">No team members found.</p>
        <%= link_to "+ Add Team Member", new_admin_user_path, class: "inline-block px-4 py-2 text-xs font-bold text-white bg-plum-700 hover:bg-plum-600 rounded-xl" %>
      </div>
    <% end %>
  </div>
</div>
