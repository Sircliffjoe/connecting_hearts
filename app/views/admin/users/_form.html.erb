<%= form_with(model: [:admin, user], local: true, class: "space-y-6") do |f| %>
  <% if user.errors.any? %>
    <div class="bg-rose-950/80 border border-rose-800 text-rose-200 p-4 rounded-xl text-xs space-y-1">
      <p class="font-bold"><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</p>
      <ul class="list-disc list-inside">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <%= f.label :name, "Full Name", class: "block text-xs font-bold text-slate-300" %>
      <%= f.text_field :name, required: true, class: "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-plum-500" %>
    </div>

    <div class="space-y-2">
      <%= f.label :email, "Email Address", class: "block text-xs font-bold text-slate-300" %>
      <%= f.email_field :email, required: true, class: "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-plum-500" %>
    </div>

    <div class="space-y-2">
      <%= f.label :role, "Role / Designation", class: "block text-xs font-bold text-slate-300" %>
      <%= f.select :role, [["Admin", "admin"], ["Super Admin", "super_admin"], ["Counselor", "counselor"]], { include_blank: "Select Role" }, required: true, class: "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-plum-500" %>
    </div>

    <div class="space-y-2">
      <%= f.label :password, user.persisted? ? "New Password (leave blank to keep unchanged)" : "Password", class: "block text-xs font-bold text-slate-300" %>
      <%= f.password_field :password, required: user.new_record?, class: "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-plum-500" %>
    </div>

    <div class="space-y-2">
      <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-bold text-slate-300" %>
      <%= f.password_field :password_confirmation, required: user.new_record?, class: "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-plum-500" %>
    </div>

    <div class="md:col-span-2">
      <%= render "shared/media_upload_field", form: f, field_name: :image_url, label_text: "Profile Photo / Avatar Image", placeholder_text: "upload profile photo or paste image URL" %>
    </div>
  </div>

  <div class="flex items-center gap-4 pt-4 border-t border-slate-800">
    <%= f.submit user.new_record? ? "Add Team Member" : "Update Team Member", class: "px-6 py-2.5 bg-plum-700 hover:bg-plum-600 text-white text-xs font-bold rounded-xl shadow-md cursor-pointer transition-colors" %>
    <%= link_to "Cancel", admin_users_path, class: "px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl transition-colors" %>
  </div>
<% end %>
