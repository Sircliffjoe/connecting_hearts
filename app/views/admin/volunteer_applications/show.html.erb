<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Volunteer Application #<%= @volunteer_application.id %></h1>
      <p class="text-xs text-slate-400">Received <%= @volunteer_application.created_at.strftime("%B %d, %Y at %H:%M") %></p>
    </div>
    <%= link_to "← Back to List", admin_volunteer_applications_path, class: "text-xs font-semibold text-slate-400 hover:text-white" %>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-6 text-sm">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-b border-slate-800 pb-4">
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Full Name</span>
        <strong class="text-white text-base"><%= @volunteer_application.full_name %></strong>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Role Interest</span>
        <strong class="text-purple-300"><%= @volunteer_application.role_interest %></strong>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Email</span>
        <a href="mailto:<%= @volunteer_application.email %>" class="text-sky-400 hover:underline font-mono"><%= @volunteer_application.email %></a>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Phone</span>
        <span class="text-slate-200"><%= @volunteer_application.phone.presence || "Not provided" %></span>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Availability</span>
        <span class="text-slate-200"><%= @volunteer_application.availability.presence || "Flexible" %></span>
      </div>
      <div>
        <span class="text-xs text-slate-400 block uppercase font-semibold">Status</span>
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
          <%= @volunteer_application.status %>
        </span>
      </div>
    </div>

    <% if @volunteer_application.skills.present? %>
      <div class="space-y-2">
        <span class="text-xs text-slate-400 block uppercase font-semibold">Skills & Background</span>
        <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 text-slate-200 leading-relaxed font-sans">
          <%= simple_format(@volunteer_application.skills) %>
        </div>
      </div>
    <% end %>

    <!-- Status & Notes Form -->
    <div class="border-t border-slate-800 pt-6 space-y-4">
      <h3 class="font-serif font-bold text-white text-base">Update Status & Internal Notes</h3>
      
      <%= form_with(model: [:admin, @volunteer_application], local: true, class: "space-y-4") do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :status, "Application Status", class: "block text-xs font-semibold uppercase text-slate-400 mb-1" %>
            <%= f.select :status, VolunteerApplication::STATUSES, {}, class: "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs" %>
          </div>
        </div>

        <div>
          <%= f.label :notes, "Internal Coordinator Notes (Private)", class: "block text-xs font-semibold uppercase text-slate-400 mb-1" %>
          <%= f.text_area :notes, rows: 3, placeholder: "Add interview details or assignment notes...", class: "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs" %>
        </div>

        <div class="flex items-center justify-between pt-2">
          <%= f.submit "Save Status & Notes", class: "px-6 py-2.5 text-xs font-bold text-white bg-purple-800 hover:bg-purple-700 rounded-xl cursor-pointer" %>
          <%= button_to admin_volunteer_application_path(@volunteer_application), method: :delete, data: { turbo_confirm: "Are you sure you want to permanently delete this volunteer application?" }, class: "px-4 py-2 text-xs font-bold text-rose-400 hover:text-white bg-rose-950/70 hover:bg-rose-900 border border-rose-800 rounded-xl transition-colors cursor-pointer" do %>
            <span>🗑 Delete Application</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
