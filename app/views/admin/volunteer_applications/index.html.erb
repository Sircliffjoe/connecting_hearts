<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Volunteer Applications</h1>
      <p class="text-xs text-slate-400">Review community volunteer applications, skillsets, and availability</p>
    </div>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Applicant Name</th>
            <th class="p-3">Role Interest</th>
            <th class="p-3">Email & Phone</th>
            <th class="p-3">Availability</th>
            <th class="p-3">Status</th>
            <th class="p-3">Date</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% if @volunteer_applications.any? %>
            <% @volunteer_applications.each do |v| %>
              <tr class="hover:bg-slate-850">
                <td class="p-3 font-semibold text-white"><%= v.full_name %></td>
                <td class="p-3 font-bold text-purple-300"><%= v.role_interest %></td>
                <td class="p-3"><%= v.email %><br><span class="text-slate-400"><%= v.phone %></span></td>
                <td class="p-3"><%= v.availability %></td>
                <td class="p-3">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
                    <%= v.status %>
                  </span>
                </td>
                <td class="p-3 whitespace-nowrap"><%= v.created_at.strftime("%b %d, %Y") %></td>
                <td class="p-3 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <%= link_to admin_volunteer_application_path(v), class: "p-2 rounded-lg bg-sky-950/60 text-sky-400 border border-sky-800/60 hover:bg-sky-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center", title: "Review Application", aria: { label: "Review Application" } do %>
                      <%= icon_eye %>
                    <% end %>
                    <%= button_to admin_volunteer_application_path(v), method: :delete, data: { turbo_confirm: "Are you sure you want to delete the application for #{v.full_name}?" }, class: "p-2 rounded-lg bg-rose-950/60 text-rose-400 border border-rose-800/60 hover:bg-rose-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center", title: "Delete Application", aria: { label: "Delete Application" } do %>
                      <%= icon_trash %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="p-8 text-center text-slate-500 italic">No volunteer applications found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
