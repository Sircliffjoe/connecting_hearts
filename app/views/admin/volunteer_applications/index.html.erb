<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <h1 class="font-serif text-2xl font-bold text-white">Volunteer Applications</h1>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Applicant Name</th>
            <th class="p-3">Role Interest</th>
            <th class="p-3">Email & Phone</th>
            <th class="p-3">Availability</th>
            <th class="p-3">Status</th>
            <th class="p-3">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% @volunteer_applications.each do |v| %>
            <tr class="hover:bg-slate-850">
              <td class="p-3 font-semibold text-white"><%= v.full_name %></td>
              <td class="p-3 font-bold text-amber-300"><%= v.role_interest %></td>
              <td class="p-3"><%= v.email %><br><span class="text-slate-400"><%= v.phone %></span></td>
              <td class="p-3"><%= v.availability %></td>
              <td class="p-3">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
                  <%= v.status %>
                </span>
              </td>
              <td class="p-3"><%= v.created_at.strftime("%b %d, %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
