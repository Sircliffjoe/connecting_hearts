<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Create Testimonial</h1>
      <p class="text-xs text-slate-400">Add a new participant reflection to feature on the website.</p>
    </div>
    <%= link_to "← Back to Testimonials", admin_testimonials_path, class: "px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl transition-colors" %>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 md:p-8 shadow-xl">
    <%= render "form", testimonial: @testimonial %>
  </div>
</div>
