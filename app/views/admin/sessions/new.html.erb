<% content_for :title, "Admin Login" %>

<div class="min-h-[70vh] flex items-center justify-center">
  <div class="max-w-md w-full bg-slate-900 border border-slate-800 p-8 rounded-3xl shadow-xl space-y-6">
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-full bg-plum-800 flex items-center justify-center text-xl font-bold text-white mx-auto">
        ♥
      </div>
      <h1 class="font-serif text-2xl font-bold text-white">Foundation Admin Portal</h1>
      <p class="text-xs text-slate-400">Sign in to manage support requests, volunteers, and content.</p>
    </div>

    <%= form_with(url: admin_login_path, local: true, class: "space-y-4") do |f| %>
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1">Email Address</label>
        <%= f.email_field :email, required: true, autofocus: true, placeholder: "admin@connectingheartsng.org", class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:ring-2 focus:ring-plum-700 outline-none" %>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1">Password</label>
        <%= f.password_field :password, required: true, placeholder: "••••••••", class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:ring-2 focus:ring-plum-700 outline-none" %>
      </div>

      <%= f.submit "Access Dashboard", class: "w-full py-3.5 text-xs font-bold text-white bg-plum-800 hover:bg-plum-700 rounded-xl shadow-md cursor-pointer transition-all" %>
    <% end %>

    <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-[11px] text-slate-400 text-center">
      Default Admin: <code class="text-amber-400">admin@connectingheartsng.org</code> / Password: <code class="text-amber-400">password123</code>
    </div>
  </div>
</div>
