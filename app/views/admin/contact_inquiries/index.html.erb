<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <h1 class="font-serif text-2xl font-bold text-white">Contact Form Inquiries</h1>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Sender Name</th>
            <th class="p-3">Email</th>
            <th class="p-3">Subject</th>
            <th class="p-3">Message Snippet</th>
            <th class="p-3">Status</th>
            <th class="p-3">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% @contact_inquiries.each do |c| %>
            <tr class="hover:bg-slate-850">
              <td class="p-3 font-semibold text-white"><%= c.name %></td>
              <td class="p-3"><%= c.email %></td>
              <td class="p-3 font-bold text-amber-300"><%= c.subject %></td>
              <td class="p-3 max-w-xs truncate"><%= c.message %></td>
              <td class="p-3">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= c.status == 'pending' ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-emerald-950 text-emerald-300 border border-emerald-800' %>">
                  <%= c.status %>
                </span>
              </td>
              <td class="p-3"><%= c.created_at.strftime("%b %d, %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
