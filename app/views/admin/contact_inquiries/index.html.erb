<div class="space-y-6" data-controller="contact-preview">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Contact Form Inquiries</h1>
      <p class="text-xs text-slate-400">Review all incoming contact messages, preview full text, and manage submissions</p>
    </div>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Sender Name</th>
            <th class="p-3">Email</th>
            <th class="p-3">Subject</th>
            <th class="p-3">Message Snippet</th>
            <th class="p-3">Status</th>
            <th class="p-3">Date</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% if @contact_inquiries.any? %>
            <% @contact_inquiries.each do |c| %>
              <tr class="hover:bg-slate-850">
                <td class="p-3 font-semibold text-white"><%= c.name %></td>
                <td class="p-3 font-mono text-slate-300"><%= c.email %></td>
                <td class="p-3 font-bold text-sky-300"><%= c.subject %></td>
                <td class="p-3 max-w-xs truncate text-slate-400"><%= c.message %></td>
                <td class="p-3">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= c.status == 'pending' ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-emerald-950 text-emerald-300 border border-emerald-800' %>">
                    <%= c.status %>
                  </span>
                </td>
                <td class="p-3 whitespace-nowrap"><%= c.created_at.strftime("%b %d, %Y") %></td>
                <td class="p-3 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <button type="button"
                            data-action="click->contact-preview#open"
                            data-name="<%= ERB::Util.html_escape(c.name) %>"
                            data-email="<%= ERB::Util.html_escape(c.email) %>"
                            data-subject="<%= ERB::Util.html_escape(c.subject) %>"
                            data-date="<%= c.created_at.strftime('%b %d, %Y %H:%M') %>"
                            data-status="<%= c.status %>"
                            data-message="<%= ERB::Util.html_escape(c.message) %>"
                            data-delete-url="<%= admin_contact_inquiry_path(c) %>"
                            class="p-2 rounded-lg bg-sky-950/60 text-sky-400 border border-sky-800/60 hover:bg-sky-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center"
                            title="Preview Message"
                            aria-label="Preview Message">
                      <%= icon_eye %>
                    </button>
                    <%= button_to admin_contact_inquiry_path(c), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this message from #{c.name}?" }, class: "p-2 rounded-lg bg-rose-950/60 text-rose-400 border border-rose-800/60 hover:bg-rose-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center", title: "Delete Message", aria: { label: "Delete Message" } do %>
                      <%= icon_trash %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="p-8 text-center text-slate-500 italic">No contact inquiries found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- PREVIEW MODAL -->
  <div data-contact-preview-target="modal" 
       data-action="click->contact-preview#closeOnBackdrop"
       class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="relative w-full max-w-xl bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-2xl space-y-6 animate-scale-up text-white">
      
      <div class="flex items-start justify-between border-b border-slate-800 pb-4">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-sky-400">Contact Message Preview</span>
          <h3 class="font-serif text-xl font-bold text-white mt-1" data-contact-preview-target="subject">Inquiry Subject</h3>
        </div>
        <button type="button" 
                data-action="click->contact-preview#close" 
                class="p-2 text-slate-400 hover:text-white text-xl font-bold rounded-xl hover:bg-slate-800 transition-colors cursor-pointer">
          ✕
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-slate-950 p-4 rounded-2xl border border-slate-800 text-xs">
        <div>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Sender Name</span>
          <span class="font-bold text-white text-sm" data-contact-preview-target="name">-</span>
        </div>
        <div>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Email Address</span>
          <span class="font-mono text-sky-300" data-contact-preview-target="email">-</span>
        </div>
        <div>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Date Received</span>
          <span class="text-slate-300" data-contact-preview-target="date">-</span>
        </div>
        <div>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Status</span>
          <span data-contact-preview-target="status" class="inline-block mt-0.5">Pending</span>
        </div>
      </div>

      <div class="space-y-2">
        <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Full Message Body</span>
        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 text-sm text-slate-200 whitespace-pre-wrap leading-relaxed max-h-60 overflow-y-auto" data-contact-preview-target="message">
          -
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-800">
        <div>
          <form data-contact-preview-target="deleteForm" method="post" class="inline-block">
            <input type="hidden" name="_method" value="delete" />
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <button type="submit" 
                    onclick="return confirm('Are you sure you want to delete this message permanently?');"
                    class="px-4 py-2 rounded-xl text-xs font-bold text-rose-300 bg-rose-950/80 hover:bg-rose-900 border border-rose-800 transition-colors cursor-pointer flex items-center gap-1.5">
              <span>🗑 Delete Message</span>
            </button>
          </form>
        </div>

        <div class="flex items-center gap-2">
          <a href="#" 
             data-contact-preview-target="emailLink"
             class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-sky-600 hover:bg-sky-500 transition-colors inline-flex items-center gap-1.5 shadow-md">
            <span>✉ Reply via Email</span>
          </a>
          <button type="button" 
                  data-action="click->contact-preview#close" 
                  class="px-4 py-2 rounded-xl text-xs font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors cursor-pointer">
            Close
          </button>
        </div>
      </div>

    </div>
  </div>

</div>
