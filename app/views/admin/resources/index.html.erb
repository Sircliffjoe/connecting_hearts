<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Manage Resources & Educational Content</h1>
      <p class="text-xs text-slate-400">Publish guides, articles, podcasts, and relationship FAQs.</p>
    </div>
    <%= link_to "+ Create New Resource", new_admin_resource_path, class: "px-4 py-2.5 text-xs font-bold text-white bg-plum-700 hover:bg-plum-600 rounded-xl shadow-md transition-colors" %>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <% if @resources.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
            <tr>
              <th class="p-3">Title</th>
              <th class="p-3">Category</th>
              <th class="p-3">Type</th>
              <th class="p-3">Status</th>
              <th class="p-3">Date</th>
              <th class="p-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <% @resources.each do |r| %>
              <tr class="hover:bg-slate-850">
                <td class="p-3 font-semibold text-white"><%= r.title %></td>
                <td class="p-3 text-amber-300 font-medium"><%= r.category %></td>
                <td class="p-3 text-slate-400"><%= r.resource_type %></td>
                <td class="p-3"><%= r.published ? "✓ Published" : "Draft" %></td>
                <td class="p-3"><%= r.created_at.strftime("%b %d, %Y") %></td>
                <td class="p-3 text-right space-x-3">
                  <%= link_to "View", admin_resource_path(r), class: "text-sky-400 hover:underline font-medium" %>
                  <%= link_to "Edit", edit_admin_resource_path(r), class: "text-amber-400 hover:underline font-medium" %>
                  <%= button_to "Delete", admin_resource_path(r), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this resource?" }, class: "text-rose-400 hover:underline inline bg-transparent cursor-pointer font-medium" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 text-slate-400 space-y-3">
        <p class="text-sm">No resources found.</p>
        <%= link_to "+ Create First Resource", new_admin_resource_path, class: "inline-block px-4 py-2 text-xs font-bold text-white bg-plum-700 hover:bg-plum-600 rounded-xl" %>
      </div>
    <% end %>
  </div>
</div>
