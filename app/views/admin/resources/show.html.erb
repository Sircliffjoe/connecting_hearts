<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <span class="text-xs font-bold text-plum-400 uppercase tracking-wider"><%= @resource.category %> • <%= @resource.resource_type %></span>
      <h1 class="font-serif text-2xl font-bold text-white mt-1"><%= @resource.title %></h1>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to "Edit Resource", edit_admin_resource_path(@resource), class: "px-4 py-2 bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold rounded-xl hover:bg-amber-500/30 transition-colors" %>
      <%= link_to "← Back", admin_resources_path, class: "px-4 py-2 bg-slate-800 text-slate-300 text-xs font-bold rounded-xl hover:bg-slate-700 transition-colors" %>
    </div>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 md:p-8 space-y-6">
    <div class="flex items-center gap-4 text-xs text-slate-400">
      <span>Status: <strong class="text-white"><%= @resource.published ? "Published" : "Draft" %></strong></span>
      <span>•</span>
      <span>Created: <strong class="text-white"><%= @resource.created_at.strftime("%B %d, %Y") %></strong></span>
    </div>

    <% if @resource.summary.present? %>
      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 italic text-slate-300 text-sm">
        <%= @resource.summary %>
      </div>
    <% end %>

    <% if @resource.content.present? %>
      <div class="prose prose-invert max-w-none text-slate-200 text-sm leading-relaxed whitespace-pre-wrap">
        <%= @resource.content %>
      </div>
    <% end %>

    <% if @resource.external_link.present? || @resource.file_url.present? %>
      <div class="pt-4 border-t border-slate-800 space-y-2 text-xs">
        <% if @resource.external_link.present? %>
          <p><strong class="text-slate-400">External Link:</strong> <%= link_to @resource.external_link, @resource.external_link, target: "_blank", class: "text-plum-400 hover:underline" %></p>
        <% end %>
        <% if @resource.file_url.present? %>
          <p><strong class="text-slate-400">Download File:</strong> <%= link_to @resource.file_url, @resource.file_url, target: "_blank", class: "text-plum-400 hover:underline" %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
