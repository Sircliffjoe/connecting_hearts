<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h1 class="font-serif text-2xl font-bold text-white">Manage Stories & Impact</h1>
      <p class="text-xs text-slate-400">Share success stories, beneficiary impact, and founder reflections.</p>
    </div>
    <%= link_to "+ Create New Story", new_admin_story_path, class: "px-4 py-2.5 text-xs font-bold text-white bg-plum-700 hover:bg-plum-600 rounded-xl shadow-md transition-colors" %>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <% if @stories.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
            <tr>
              <th class="p-3">Title</th>
              <th class="p-3">Category</th>
              <th class="p-3">Status</th>
              <th class="p-3">Featured</th>
              <th class="p-3">Date</th>
              <th class="p-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <% @stories.each do |s| %>
              <tr class="hover:bg-slate-850">
                <td class="p-3 font-semibold text-white"><%= s.title %></td>
                <td class="p-3 text-amber-300 font-medium"><%= s.category %></td>
                <td class="p-3"><%= s.published ? "✓ Published" : "Draft" %></td>
                <td class="p-3"><%= s.featured ? "⭐ Yes" : "No" %></td>
                <td class="p-3"><%= s.created_at.strftime("%b %d, %Y") %></td>
                <td class="p-3 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <%= link_to admin_story_path(s), class: "p-2 rounded-lg bg-sky-950/60 text-sky-400 border border-sky-800/60 hover:bg-sky-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center", title: "View Story", aria: { label: "View Story" } do %>
                      <%= icon_eye %>
                    <% end %>
                    <%= link_to edit_admin_story_path(s), class: "p-2 rounded-lg bg-amber-950/60 text-amber-400 border border-amber-800/60 hover:bg-amber-900 hover:text-white transition-colors shadow-sm inline-flex items-center justify-center", title: "Edit Story", aria: { label: "Edit Story" } do %>
                      <%= icon_pencil %>
                    <% end %>
                    <%= button_to admin_story_path(s), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this story?" }, class: "p-2 rounded-lg bg-rose-950/60 text-rose-400 border border-rose-800/60 hover:bg-rose-900 hover:text-white transition-colors shadow-sm cursor-pointer inline-flex items-center justify-center", title: "Delete Story", aria: { label: "Delete Story" } do %>
                      <%= icon_trash %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 text-slate-400 space-y-3">
        <p class="text-sm">No stories found.</p>
        <%= link_to "+ Create First Story", new_admin_story_path, class: "inline-block px-4 py-2 text-xs font-bold text-white bg-plum-700 hover:bg-plum-600 rounded-xl" %>
      </div>
    <% end %>
  </div>
</div>
