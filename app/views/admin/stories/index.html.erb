<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <h1 class="font-serif text-2xl font-bold text-white">Manage Stories & Impact</h1>
  </div>

  <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
          <tr>
            <th class="p-3">Title</th>
            <th class="p-3">Category</th>
            <th class="p-3">Published</th>
            <th class="p-3">Featured</th>
            <th class="p-3">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% @stories.each do |s| %>
            <tr class="hover:bg-slate-850">
              <td class="p-3 font-semibold text-white"><%= s.title %></td>
              <td class="p-3 text-amber-300"><%= s.category %></td>
              <td class="p-3"><%= s.published ? "✓ Yes" : "Draft" %></td>
              <td class="p-3"><%= s.featured ? "⭐ Yes" : "No" %></td>
              <td class="p-3"><%= s.created_at.strftime("%b %d, %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
