<%= form_with(model: [:admin, story], local: true, class: "space-y-6") do |f| %>
  <% if story.errors.any? %>
    <div class="bg-rose-950/80 border border-rose-800 text-rose-200 p-4 rounded-xl text-xs space-y-1">
      <p class="font-bold"><%= pluralize(story.errors.count, "error") %> prohibited this story from being saved:</p>
      <ul class="list-disc list-inside">
        <% story.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <%= f.label :title, "Story Title", class: "block text-xs font-bold text-slate-300" %>
      <%= f.text_field :title, required: true, class: "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-plum-500" %>
    </div>

    <div class="space-y-2">
      <%= f.label :category, "Category", class: "block text-xs font-bold text-slate-300" %>
      <%= f.select :category, Story::CATEGORIES, { include_blank: "Select Category" }, class: "w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-plum-500" %>
    </div>

    <div class="md:col-span-2">
      <%= render "shared/media_upload_field", form: f, field_name: :image_url, label_text: "Story Cover Image / Media", placeholder_text: "pic11.jpeg or upload file below" %>
    </div>
  </div>

  <div class="space-y-2">
    <%= f.label :summary, "Summary / Short Excerpt", class: "block text-xs font-bold text-slate-300" %>
    <%= f.text_area :summary, rows: 3, class: "w-full bg-slate-950 border border-slate-800 rounded-xl p-4 text-sm text-white focus:outline-none focus:border-plum-500" %>
  </div>

  <div class="space-y-2">
    <%= f.label :body, "Story Body / Full Content", class: "block text-xs font-bold text-slate-300" %>
    <%= f.text_area :body, required: true, rows: 8, class: "w-full bg-slate-950 border border-slate-800 rounded-xl p-4 text-sm text-white focus:outline-none focus:border-plum-500" %>
  </div>

  <div class="flex flex-wrap gap-6 pt-2">
    <div class="flex items-center gap-3">
      <%= f.check_box :published, class: "w-4 h-4 rounded bg-slate-950 border-slate-800 text-plum-600 focus:ring-plum-500" %>
      <%= f.label :published, "Publish Story Immediately", class: "text-xs text-slate-300 font-medium cursor-pointer" %>
    </div>

    <div class="flex items-center gap-3">
      <%= f.check_box :featured, class: "w-4 h-4 rounded bg-slate-950 border-slate-800 text-plum-600 focus:ring-plum-500" %>
      <%= f.label :featured, "Mark as Featured Story", class: "text-xs text-slate-300 font-medium cursor-pointer" %>
    </div>
  </div>

  <div class="flex items-center gap-4 pt-4 border-t border-slate-800">
    <%= f.submit story.new_record? ? "Publish Story" : "Update Story", class: "px-6 py-2.5 bg-plum-700 hover:bg-plum-600 text-white text-xs font-bold rounded-xl shadow-md cursor-pointer transition-colors" %>
    <%= link_to "Cancel", admin_stories_path, class: "px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl transition-colors" %>
  </div>
<% end %>
