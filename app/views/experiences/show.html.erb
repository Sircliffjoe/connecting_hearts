<% content_for :title, "#{@event[:title]} | Connecting Hearts Experience" %>
<% content_for :description, "#{@event[:title]} - #{@event[:theme]} in #{@event[:location]}. Read event recaps, post-event highlights, speaker insights, and participant reflections." %>

<!-- Hero Header -->
<section class="brand-gradient text-white pt-28 pb-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
    
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to experiences_path, class: "inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 hover:bg-white/20 text-xs font-bold text-white transition-colors border border-white/20" do %>
        <span>← All Experiences</span>
      <% end %>
      <span class="px-3.5 py-1 rounded-full bg-amber-400 text-plum-950 text-xs font-bold uppercase tracking-wider shadow-sm">
        Edition <%= @event[:edition_number] %>
      </span>
      <span class="px-3.5 py-1 rounded-full bg-white/15 text-purple-100 text-xs font-medium border border-white/20">
        <%= @event[:event_type] %>
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8 space-y-4">
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
          <%= @event[:title] %>
        </h1>
        <p class="text-xl sm:text-2xl font-serif text-amber-200 italic">
          Theme: "<%= @event[:theme] %>"
        </p>
        <p class="text-base text-purple-100/90 leading-relaxed font-sans font-light max-w-3xl">
          <%= @event[:description] %>
        </p>

        <div class="pt-4 flex flex-wrap gap-6 text-sm text-purple-100 font-medium border-t border-white/15">
          <div class="flex items-center gap-2">
            <span>📅</span>
            <span><%= @event[:event_date].strftime("%B %d, %Y • %I:%M %p") %></span>
          </div>
          <div class="flex items-center gap-2">
            <span>📍</span>
            <span><%= @event[:location] %></span>
          </div>
          <div class="flex items-center gap-2">
            <span>👥</span>
            <span>Capacity: <%= @event[:capacity] %> Participants</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-4">
        <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white/20 max-h-80">
          <img src="<%= safe_image_path(@event[:image_url]) %>" alt="<%= @event[:title] %>" class="w-full h-full object-cover">
        </div>
      </div>
    </div>

  </div>
</section>


<!-- Main Event Content & Post-Event Details -->
<section class="py-16 bg-warm-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Post-Event Highlights & Speaker Info -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- Post-Event Highlights Card -->
        <div class="bg-white p-8 sm:p-10 rounded-3xl border border-warm-300 shadow-sm space-y-6">
          <div class="flex items-center justify-between border-b border-warm-200 pb-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-terracotta-600">Event Documentation</span>
              <h2 class="font-serif text-2xl font-bold text-plum-950">Post-Event Highlights & Takeaways</h2>
            </div>
            <span class="px-3 py-1 bg-plum-100 text-plum-900 rounded-full text-xs font-bold">Official Recap</span>
          </div>

          <div class="space-y-4">
            <% if @event[:post_event_highlights].present? %>
              <% Array(@event[:post_event_highlights]).each do |highlight| %>
                <div class="flex items-start gap-4 p-4 rounded-2xl bg-warm-50 border border-warm-200">
                  <div class="w-8 h-8 rounded-full bg-plum-900 text-white flex items-center justify-center font-bold text-sm shrink-0">
                    ✓
                  </div>
                  <p class="text-sm text-charcoal-800 leading-relaxed font-medium pt-1">
                    <%= highlight %>
                  </p>
                </div>
              <% end %>
            <% else %>
              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <span class="text-terracotta-600 font-bold">✓</span>
                  <p class="text-sm text-charcoal-800">In-depth discussion on communication barriers, emotional intimacy, and resolving marital conflict in a safe environment.</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="text-terracotta-600 font-bold">✓</span>
                  <p class="text-sm text-charcoal-800">Free intake consultations initiated for couples and individuals requiring professional therapy.</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="text-terracotta-600 font-bold">✓</span>
                  <p class="text-sm text-charcoal-800">Unveiling of educational support initiatives for vulnerable children and tertiary students.</p>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Impact & Community Metrics -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="bg-plum-950 text-white p-6 rounded-3xl text-center space-y-1 shadow-md">
            <span class="block font-serif text-3xl font-bold text-amber-300"><%= @event[:impact_stats]&.[](:attendees) || "#{@event[:capacity]}+ Attendees" %></span>
            <span class="text-xs text-purple-200 font-medium uppercase tracking-wider">Attendance Impact</span>
          </div>

          <div class="bg-white border border-warm-300 p-6 rounded-3xl text-center space-y-1 shadow-xs">
            <span class="block font-serif text-3xl font-bold text-plum-900"><%= @event[:impact_stats]&.[](:counseling_referrals) || "Confidential Therapy" %></span>
            <span class="text-xs text-charcoal-600 font-medium uppercase tracking-wider">Counseling Support</span>
          </div>

          <div class="bg-white border border-warm-300 p-6 rounded-3xl text-center space-y-1 shadow-xs">
            <span class="block font-serif text-3xl font-bold text-terracotta-600"><%= @event[:impact_stats]&.[](:materials_shared) || "100% Free Materials" %></span>
            <span class="text-xs text-charcoal-600 font-medium uppercase tracking-wider">Resources Distributed</span>
          </div>
        </div>

        <!-- Featured Speakers & Keynotes -->
        <div class="bg-white p-8 sm:p-10 rounded-3xl border border-warm-300 shadow-sm space-y-6">
          <h2 class="font-serif text-2xl font-bold text-plum-950">Speakers & Session Facilitators</h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex items-center gap-4 p-4 rounded-2xl bg-warm-100 border border-warm-300">
              <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-plum-700 shrink-0">
                <img src="<%= image_path('eloho-sodje.jpeg') %>" alt="Eloho Sodje" class="w-full h-full object-cover">
              </div>
              <div>
                <h4 class="font-serif font-bold text-base text-plum-950">Eloho Sodje</h4>
                <p class="text-xs font-semibold text-terracotta-600 uppercase">Founder & Keynote Speaker</p>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 rounded-2xl bg-warm-100 border border-warm-300">
              <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-plum-700 shrink-0">
                <img src="<%= image_path('anthony-sodje.jpeg') %>" alt="Pastor Anthony Sodje" class="w-full h-full object-cover">
              </div>
              <div>
                <h4 class="font-serif font-bold text-base text-plum-950">Pastor Anthony Sodje</h4>
                <p class="text-xs font-semibold text-terracotta-600 uppercase">Co-Founder & Trustee</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Photo Gallery from the Edition -->
        <% if @event[:gallery_images].present? %>
        <div class="bg-white p-8 sm:p-10 rounded-3xl border border-warm-300 shadow-sm space-y-6">
          <h2 class="font-serif text-2xl font-bold text-plum-950">Event Moments & Gallery</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <% Array(@event[:gallery_images]).each do |img| %>
              <div class="rounded-2xl overflow-hidden h-44 border border-warm-300 shadow-xs group">
                <img src="<%= safe_image_path(img) %>" alt="<%= @event[:title] %> gallery photo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
              </div>
            <% end %>
          </div>
        </div>
        <% end %>

      </div>


      <!-- Right Column: Registration / Post-Event Action Form -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Interactive Card -->
        <div class="bg-white p-8 rounded-3xl border border-warm-300 shadow-lg space-y-6 sticky top-28">
          
          <% if @event[:event_date] >= Time.current %>
            <!-- Upcoming Event Registration -->
            <div class="space-y-2 border-b border-warm-200 pb-4">
              <span class="inline-block bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase">Registration Open</span>
              <h3 class="font-serif text-2xl font-bold text-plum-950">Reserve Your Spot</h3>
              <p class="text-xs text-charcoal-600">Free admission powered by Connecting Hearts Foundation.</p>
            </div>

            <%= form_with(model: EventRegistration.new, url: event_registrations_path, local: true, class: "space-y-4") do |f| %>
              <%= render "shared/spam_protection_fields" %>
              <%= f.hidden_field :event_id, value: @event[:id] %>

              <div>
                <%= f.label :full_name, "Your Full Name", class: "block text-xs font-bold uppercase tracking-wider text-plum-950 mb-1" %>
                <%= f.text_field :full_name, required: true, placeholder: "e.g. Eloho Sodje", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-700 outline-none text-xs bg-warm-50" %>
              </div>

              <div>
                <%= f.label :email, "Email Address", class: "block text-xs font-bold uppercase tracking-wider text-plum-950 mb-1" %>
                <%= f.email_field :email, required: true, placeholder: "you@example.com", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-700 outline-none text-xs bg-warm-50" %>
              </div>

              <div>
                <%= f.label :phone, "Phone / WhatsApp", class: "block text-xs font-bold uppercase tracking-wider text-plum-950 mb-1" %>
                <%= f.telephone_field :phone, placeholder: "+234...", class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-700 outline-none text-xs bg-warm-50" %>
              </div>

              <div>
                <%= f.label :attendance_type, "Attendance Format", class: "block text-xs font-bold uppercase tracking-wider text-plum-950 mb-1" %>
                <%= f.select :attendance_type, [["In-Person (Warri)", "in_person"], ["Virtual Stream", "virtual"]], {}, class: "w-full px-4 py-3 rounded-xl border border-warm-300 focus:ring-2 focus:ring-plum-700 outline-none text-xs bg-warm-50 font-medium" %>
              </div>

              <%= f.submit "Complete Free Registration", class: "w-full py-4 text-xs font-bold text-white brand-btn-gradient rounded-xl cursor-pointer shadow-md" %>
            <% end %>

          <% else %>
            <!-- Past Event Follow-up / Counseling Call to Action -->
            <div class="space-y-3 border-b border-warm-200 pb-4">
              <span class="inline-block bg-purple-100 text-purple-900 text-xs font-bold px-3 py-1 rounded-full uppercase">Edition Completed</span>
              <h3 class="font-serif text-2xl font-bold text-plum-950">Missed This Experience?</h3>
              <p class="text-xs text-charcoal-700 leading-relaxed">
                You can still access free confidential counseling or request session materials from this edition.
              </p>
            </div>

            <div class="space-y-3 pt-2">
              <%= link_to new_support_request_path, class: "block w-full py-3.5 text-center text-xs font-bold text-white brand-btn-gradient rounded-xl shadow-md" do %>
                Request Confidential Therapy
              <% end %>
              <%= link_to contact_path, class: "block w-full py-3.5 text-center text-xs font-bold text-plum-900 bg-warm-100 hover:bg-warm-200 rounded-xl border border-warm-300 transition-colors" do %>
                Inquire About Session Recordings
              <% end %>
            </div>
          <% end %>

          <div class="pt-4 border-t border-warm-200 text-center text-[11px] text-charcoal-500">
            <span>Event Code: <strong class="font-mono text-plum-900"><%= @event[:id] %></strong></span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
